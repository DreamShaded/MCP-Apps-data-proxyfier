{
  "name": "mcp-app-proxyfier",
  "version": "1.0.0",
  "description": "Proxying MCP server that serves interactive MCP Apps for Sber services",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @mcp-app-proxyfier/ui build && pnpm --filter @mcp-app-proxyfier/server build",
    "build:ui": "pnpm --filter @mcp-app-proxyfier/ui build",
    "build:server": "pnpm --filter @mcp-app-proxyfier/server build",
    "start": "pnpm --filter @mcp-app-proxyfier/server start",
    "test": "pnpm --filter @mcp-app-proxyfier/server test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.3",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
