{
  "name": "@mcp-app-proxyfier/server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "bin": {
    "mcp-app-proxyfier": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prestart": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "update:data": "tsx scripts/update-data.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "pnpm typecheck && node --test --import tsx 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
