{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  // Тесты тайпчекаются вместе с кодом. Раньше они были исключены, а гоняются через tsx,
  // который типы не проверяет, — и `tsc` молча зеленел на тестах, импортирующих удалённые
  // модули. Из сборки их убирает не exclude, а отдельный tsconfig.build.json.
  "include": ["src"]
}
