{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true
  },
  // Тесты тайпчекаются вместе с кодом: гоняет их tsx, который типы не проверяет, — без
  // этого `tsc` зеленеет на тестах, ссылающихся на удалённое. В бандл они не попадают:
  // Vite собирает от точек входа (`*.html`), а не от tsconfig.
  "include": ["src", "vite.config.ts"]
}
