            "text": ".giga-input-field__form{flex-direction:column;gap:8px;display:flex}.giga-input-field__input-container{-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);background:#f2f5f7cc;border-radius:20px;align-items:center;gap:8px;padding:8px;transition:background-color .2s;display:flex}.giga-input-field__input-container:hover,.giga-input-field__input-container:active,.giga-input-field__input-container:focus-within{background:#f2f5f7}.giga-input-field__input-label{letter-spacing:-.1px;background:#fff;border-radius:16px;width:100%;padding:17px 16px;font-family:SBSansText,OpenSans,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:16px;font-weight:500;line-height:22px;display:flex;position:relative;overflow:hidden}.giga-input-field__input{width:100%;max-width:calc(100% - 45px);height:22px;font:inherit;color:#262626;resize:none;border:none;padding:0}.giga-input-field__input:focus::placeholder,.giga-input-field__input:active::placeholder,.giga-input-field__input:hover::placeholder{color:#2626268f}.giga-input-field__input::input-placeholder{color:#0003}.giga-input-field__input::placeholder{color:#0003}.giga-input-field__input:input-placeholder{color:#0003}.giga-input-field__input{touch-action:none}.giga-input-field__input:focus{outline:none}.giga-input-field__gradient-overlay{pointer-events:none;background:linear-gradient(90deg,#fff 40%,#fff0 100%);width:58px;height:100%;transition:opacity .3s;position:absolute;top:0;left:0}.giga-input-field__submit-button{cursor:pointer;border:none;border-radius:12px;flex-shrink:0;justify-content:center;align-self:end;align-items:center;width:40px;height:40px;transition:opacity .2s;display:flex;position:absolute;bottom:16px;right:16px}.giga-input-field__submit-button:hover{opacity:.7}.giga-input-field__submit-button:focus-visible{border:2px solid #000}.giga-input-field__submit-button svg{flex-shrink:0}.giga-input-field__submit-button:focus{outline:none}.giga-input-field__error-message{letter-spacing:-.2px;color:#1724