            "size": 226858,
            "mimeType": "text/html",
            "text": "\n    <!DOCTYPE html>\n    <html dir=\"ltr\" lang=\"ru\" prefix=\"og: http://ogp.me/ns# article: http://ogp.me/ns/article#\">\n        \n    <head>\n        <title>404_ru</title>\n        \n        \n        <meta name=\"viewport\"\n            content=\"viewport-fit=cover, width=device-width, initial-scale=1.0\">\n        \n        \n        \n        \n        <meta name=\"twitter:title\" content=\"404_ru\"/>\n        <meta property=\"og:title\" content=\"404_ru\"/>\n        \n        \n        <meta name=\"color-scheme\" content=\"only light\"/>\n        <meta name=\"twitter:card\" content=\"summary\"/>\n        <meta name=\"twitter:site\" content=\"@sberbank\"/>\n        <meta name=\"og:type\" content=\"website\"/>\n        <meta property=\"og:image\" content=\"/common_static/social-ru.png\"/>\n        <meta name=\"twitter:image\" content=\"/common_static/social-ru.png\">\n        <meta property=\"og:image:width\" content=\"200\"/>\n        <meta property=\"og:image:height\" content=\"200\"/>\n    \n\n        <link href=\"/static/sbercraft/modules/front-admin-constructor/D-03.091.001/constructor/uiKitt.css?v=-2005387575\" rel=\"preload\" as=\"style\" onload=\"this.onload=null;this.rel='stylesheet'\" />\n        <link href=\"/static/sbercraft/modules/front-admin-constructor/D-03.091.001/constructor/universalKitt.css?v=-2005387575\" rel=\"preload\" as=\"style\" onload=\"this.onload=null;this.rel='stylesheet'\"/>\n\n        <script defer src=\"/proxy/static/node-page-renderer/client/main.js?v=?v=-2056181231\">\n        </script>\n        \n        \n    <meta charset=\"UTF-8\" />\n    <meta http-equiv=\"X-UA-TextLayoutMetrics\" content=\"gdi\" />\n    <meta http-equiv=\"cleartype\" content=\"on\"/>\n    <meta http-equiv=\"X-DNS-Prefetch-Control\" content=\"on\"/>\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\"/>\n    <meta name=\"theme-color\" content=\"#ffffff\"/>\n    <meta name=\"msapplication-TileColor\" content=\"#21A038\"/>\n    <meta name=\"msapplication-navbutton-color\" content=\"#ffffff\"/>\n    <meta name=\"msapplication-tap-highlight\" content=\"no\"/>\n    <link rel=\"manifest\" href=\"/common_static/site.webmanifest\"/>\n    <meta name=\"format-detection\" content=\"telephone=no\"/>\n    <meta name=\"google\" content=\"notranslate\"/>\n\n\n    <link rel=\"preconnect\" href=\"//mc.yandex.ru\"/>\n\n\n    <link rel=\"apple-touch-icon\"\n        href=\"/common_static/apple-touch-icon-72x72.png\" sizes=\"72x72\"/>\n    <link rel=\"apple-touch-icon\"\n        href=\"/common_static/apple-touch-icon-76x76.png\" sizes=\"76x76\"/>\n    <link rel=\"apple-touch-icon\"\n        href=\"/common_static/apple-touch-icon-144x144.png\" sizes=\"144x144\"/>\n    <link rel=\"apple-touch-icon\"\n        href=\"/common_static/apple-touch-icon-152x152.png\" sizes=\"152x152\"/>\n    <link rel=\"apple-touch-icon\"\n        href=\"/common_static/apple-touch-icon-180x180.png\" sizes=\"180x180\"/>\n    <link rel=\"apple-touch-icon\"\n        href=\"/common_static/apple-touch-icon.png\"/>\n    <link rel=\"mask-icon\"\n        href=\"/common_static/safari-pinned-tab.svg\" color=\"#21A038\"/>\n    <meta name=\"msapplication-TileImage\"\n        content=\"/common_static/apple-touch-icon-144x144.png\"/>\n    <link rel=\"icon\"\n        href=\"/common_static/favicon-16x16.png\" type=\"image/png\" sizes=\"16x16\"/>\n    <link rel=\"icon\"\n        href=\"/common_static/favicon-32x32.png\" type=\"image/png\" sizes=\"32x32\"/>\n    <link rel=\"shortcut icon\"\n        href=\"/common_static/favicon.ico\"/>\n\n\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"http://schema.org\",\n      \"@type\": \"BankOrCreditUnion\",\n      \"address\": {\n         \"@type\": \"PostalAddress\",\n         \"addressLocality\": \"Москва\",\n         \"postalCode\": \"117312\",\n         \"streetAddress\": \"Вавилова, 19\",\n         \"addressCountry\": \"RU\"\n      },\n      \"email\": \"sberbank@sberbank.com\",\n      \"name\": \"ПАО Сбербанк\",\n      \"telephone\": \"+7 495 665-5-777\",\n      \"legalName\": \"ПАО «Сбербанк»\",\n      \"contactPoint\":[\n         {\n            \"@type\":\"ContactPoint\",\n            \"telephone\":\"900\",\n            \"contactType\":\"Customer service\"\n         }\n      ],\n      \"image\":{\n         \"url\":\"https://www.sberbank.ru/common_static/favicon-32x32.png\",\n         \"@type\":\"ImageObject\"\n      },\n      \"sameAs\":[\n         \"https://vk.com/sberbank\",\n         \"https://ok.ru/sber\",\n         \"https://t.me/sberbank\"\n      ]\n    }\n    </script>\n\n<script>\n    globalThis.addEventListener('DOMContentLoaded', () => {\n        if (location.hash) {\n            const componentIdLoadWaitTime = 5000;\n            const hashId = location.hash.replace('#', '');\n\n            const originalHash = location.hash;\n\n            const startTimeRepeat = Date.now();\n            const interval = setInterval(() => {\n                const elementToScroll = globalThis.document?.getElementById(hashId);\n                const timeWaitExceeded = Date.now() - startTimeRepeat > componentIdLoadWaitTime;\n\n                const hashStillRelevant = location.hash === originalHash;\n\n                if (elementToScroll && hashStillRelevant) {\n                    clearInterval(interval);\n                    setTimeout(() => {\n                        elementToScroll.scrollIntoView({\n                            behavior: 'smooth',\n                            block: 'start'\n                        });\n                    }, 50);\n                }\n\n                if (timeWaitExceeded || !hashStillRelevant) {\n                    clearInterval(interval);\n                }\n            }, 50);\n        }\n    });\n\n    globalThis.addEventListener('hashchange', () => {\n        if (location.hash) {\n            const hashId = location.hash.replace('#', '');\n            setTimeout(() => {\n                const elementToScroll = globalThis.document?.getElementById(hashId);\n\n                if (elementToScroll) {\n                    elementToScroll.scrollIntoView({\n                        behavior: 'smooth',\n                        block: 'start'\n                    });\n                }\n            }, 100);\n        }\n    });\n</script>\n\n    <!-- Start Sber Tag Manager -->\n    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'stm.start':\n    new Date().getTime(),event:'stm_init'});\n    w['stmUrl']='https://stmtag.ru/';\n    var f=d.getElementsByTagName(s)[0], j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';\n    j.async=true;j.src='https://stmtag.ru/stm/container/'+i+'.js';\n    f.parentNode.insertBefore(j,f);\n    })(window,document,'script','dataLayer','STM-XOU2D1');</script>\n    <!-- End Sber Tag Manager -->\n\n        \n    \n\n    \n    <script>window.__LEGACY_LIBS = [];</script>\n    <style data-styled=\"true\" data-styled-version=\"5.3.11\">.ldpavL:empty{display:none;}/*!sc*/\n@media (max-width:767px){.ldpavL{padding-top:0px;padding-bottom:0px;background:undefined;border-radius:undefined;}}/*!sc*/\n@media (min-width:768px) and (max-width:1023px){.ldpavL{padding-top:0px;padding-bottom:0px;background:undefined;border-radius:undefined;}}/*!sc*/\n@media (min-width:1024px){.ldpavL{padding-top:0px;padding-bottom:0px;background:undefined;border-radius:undefined;}}/*!sc*/\n.kdBFoH:empty{display:none;}/*!sc*/\n@media (max-width:767px){.kdBFoH{padding-top:48px;padding-bottom:48px;background:undefined;border-radius:undefined;}}/*!sc*/\n@media (min-width:768px) and (max-width:1023px){.kdBFoH{padding-top:48px;padding-bottom:48px;background:undefined;border-radius:undefined;}}/*!sc*/\n@media (min-width:1024px){.kdBFoH{padding-top:64px;padding-bottom:64px;background:undefined;border-radius:undefined;}}/*!sc*/\n.cCwbtQ:empty{display:none;}/*!sc*/\n@media (max-width:767px){.cCwbtQ{padding-top:64px;padding-bottom:0px;background:undefined;border