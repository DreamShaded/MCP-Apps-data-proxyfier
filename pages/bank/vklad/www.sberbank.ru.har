 для авто-режима для задания числа слайдов, а также положения стрелок\"},{\"version\":\"1.2.0\",\"releaseDate\":\"2025-11-06\",\"description\":\"добавление настройки по выравниванию слайдов по вертикали\"}]},{\"type\":\"tabs\",\"tabs\":[{\"name\":\"content\",\"title\":\"Контент\",\"settings\":[\"slides\",\"slideAlign\",\"editorialSlideBackground\",\"marginBetweenSlides\",\"slidesOnScreen\",\"autoSlidesCount\",\"marginTop\",\"marginBot\",\"marginRight\",\"marginLeft\",\"slidesMode\",\"loop\",\"isAutoPlay\"]},{\"name\":\"design\",\"title\":\"Дизайн\",\"settings\":[\"showScrollIcons\",\"showPagination\"]}]},{\"name\":\"slides\",\"type\":\"array\",\"mandatory\":false,\"adaptive\":false,\"defaultValue\":[{\"title\":\"Заголовок\"}],\"arrayCardsNumber\":[1,20],\"arraySchema\":{\"title\":{\"name\":\"tittle\",\"description\":\"Заголовок\",\"type\":\"string\",\"placeholder\":\"Заголовок\",\"adaptive\":true,\"mandatory\":false,\"defaultValue\":\"Заголовок\"}}},{\"name\":\"slideAlign\",\"description\":\"Выравнивание слайдов\",\"type\":\"verticalAlign\",\"defaultValue\":\"top\",\"options\":[{\"label\":\"К верхнему краю\",\"value\":\"top\"},{\"label\":\"По центру\",\"value\":\"center\"},{\"label\":\"К нижнему краю\",\"value\":\"bottom\"}],\"adaptive\":true},{\"name\":\"editorialSlideBackground\",\"description\":\"Показать технические поля\",\"type\":\"toggle\",\"defaultValue\":false,\"options\":[{\"value\":true},{\"value\":false}]},{\"name\":\"marginBetweenSlides\",\"description\":\"Расстояние между слайдами\",\"type\":\"number\",\"defaultValue\":8,\"maxValue\":200,\"minValue\":1,\"horizontal\":true,\"mandatory\":false,\"adaptive\":true},{\"name\":\"autoSlidesCount\",\"description\":\"Авто-режим\",\"tooltipText\":\"Включает автоматический расчёт количества слайдов по ширине контейнера\",\"type\":\"toggle\",\"options\":[{\"value\":true},{\"value\":false}],\"defaultValue\":false,\"adaptive\":true,\"mandatory\":false,\"dependencies\":[{\"option\":true,\"name\":\"marginLeft\",\"descr