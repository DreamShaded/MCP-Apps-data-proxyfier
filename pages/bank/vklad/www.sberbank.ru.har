          "content": {
            "size": 3499,
            "mimeType": "application/json",
            "text": "{\n    \"promptName\": \"Podborshchik_vkladov_sse\",\n    \"historyLength\": 20,\n    \"paddingTopDesktop\": \"48px\",\n    \"paddingBottomDesktop\": \"64px\",\n    \"paddingTopTabletMobile\": \"32px\",\n    \"paddingBottomTabletMobile\": \"48px\",\n    \"mainTitle\": \"Спросите об условиях вклада онлайн\",\n    \"mainTitleColor\": \"#262626\",\n    \"mainSubtitle\": \"ГигаЧат быстро найдёт информацию о надбавках, минимальной сумме и подскажет, как открыть вклад\",\n    \"mainSubtitleColor\": \"#262626\",\n    \"tooltipText\": \"Gigaсhat - нейросетевая модель, с помощью которой пользователи могут генерировать тексты и изображения по текстовому описанию. Информация, сгенерированная Gigachat, не является индивидуальной рекомендацией и/или финансовой консультацией, руководством для принятия решений или совершении каких-либо действий, предоставлением информации о продуктах и услугах Банка в соответствии с законодательством о защите прав потребителей или рекламой. За получением подробной информации об услугах можно обратиться в офис Банка или позвонить по номеру 900. 18+\",\n    \"tooltipColor\": \"\", \n    \"inputPlaceholder\": \"Задайте свой вопрос\",\n    \"searchPanelBackground\": \"rgba(238, 247, 243, 0.4)\",\n    \"searchPanelBorderColor\": \"\",\n    \"backgroundColor\": \"#rrgba(0, 0, 0, 0)\",\n    \"loaderText\": \"Уже пишем ответ...\",\n    \"aiGeneratedColor\": \"#262626\",\n    \"backgroundInDialog\": \"\",\n    \"opacityTopLine\":\"0.5\",\n   \"suggestions\": \"Что такое «новые деньги»|Как получить надбавки|Какая минимальная сумма|Вклады в Сбере\",\n    \"suggestionsBackgroundColor\": \"rgba(255, 255, 255, 0.32)\",\n    \"suggestionsHoverColor\": \"#0000000d\",\n    \"suggestionsTextColor\": \"#262626\",\n    \"suggestionsTextColorHover\": \"#262626\",\n    \"suggestionsBorder\": \"#eef0f2\",\n    \"descriptionSuggestionsColor\": \"#262626\",\n    \"backgroundImage\": \"\",\n    \"sendButtonColor\": \"linear-gradient(to right, rgb(100, 238, 97), rgb(50, 184, 211))\",\n    \"arrowColor\": \"#fff\",\n    \"gigachatPolicyColor\": \"#262626\",\n    \"assistantColorText\": \"#262626\",\n    \"backgroundFeedback\": \"rgba(38, 38, 38, 0.08)\",\n    \"scrollColor\": \"rgba(38, 38, 38, 0.24)\",\n    \"tabs\": {\n        \"tabsBackground\": \"rgba(255, 255, 255, 0.32)\",\n        \"activeTabColor\": \"linear-gradient(to right, rgb(100, 238, 97), rgb(50, 184, 211))\",\n        \"textColor\": \"#262626\",\n        \"textColorActive\": \"#fff\",\n        \"items\": [\n            {\n                \"text\": \"Совместные финансы\",\n                \"icon\": \"https://www.sberbank-ru.os-trunk.sberbank.ru/common/fhouse/test/alexa/gig/black_ruble.svg\",\n                \"iconActive\": \"https://www.sberbank-ru.os-trunk.sberbank.ru/common/fhouse/test/alexa/gig/ruble.svg\",\n                \"suggestions\": \"Совместные финансы1|Совместные финансы2|Совместные финансы3|Совместные финансы4\"\n            }\n        ]\n    }\n}\n"
