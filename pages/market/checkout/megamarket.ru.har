            "text": ".search-form .search-form-suggestions-container{background:var(--pui-bg-layer-01, );border-radius:24px;box-shadow:0 3px 12px rgba(0,0,0,.1);font-family:MegaSans,Helvetica,Arial,Verdana,Tahoma,sans-serif;font-size:14px;font-weight:400;left:0;line-height:20px;max-height:calc(75vh + 50px);padding-top:50px;position:absolute;right:0;top:0;z-index:5;--mixin-calculated-line-height:20px}.search-form .search-form-suggestions-container .search-form-suggestions{max-height:75vh;overflow:auto;padding-bottom:20px}.search-form .search-form-suggestions-container .search-form-suggestions__item{color:var(--pui-text-primary, );display:block;padding:5px 12px;transition:none;user-select:none}.search-form .search-form-suggestions-container .search-form-suggestions__item:hover{background-color:var(--pui-bg-layer-00, )}.search-form .search-form-suggestions-container .search-form-suggestions__empty{color:var(--pui-text-tertiary, )}.search-form .search-form-suggestions-container .search-form-suggestions mark{background:none;color:var(--pui-text-primary, );font-weight:500}.search-form .search-form-suggestions-container .search-form-suggestions a.selected,.search-form .search-form-suggestions-container .search-form-suggestions a:hover{color:var(--pui-link-active, )}.search-form .search-form-suggestions-container .search-form-suggestions a.selected mark,.search-form .search-form-suggestions-container .search-form-suggestions a:hover mark{color:inherit}.search-form .search-form-suggestions-container .search-form-suggestions__group{display:block}.search-form .search-form-suggestions-container .search-form-suggestions__group:first-of-type{border-top:0}.search-form .search-form-suggestions-container .search-form-suggestions .group-title{color:var(--pui-text-primary, );display:block;font-weight:500;margin-top:10px;padding:9px 40px 9px 16px}.search-form .search-form-clear-button{align-items:center;display:flex;justify-content:center}.search-form:not(.focused) .search-form-suggestions-container{display:none}.search-form:not(.focused) .search-field,.search-form:not(.with-suggestions) .search-field{border-color:var(--pui-border-primary, )}@media (max-width:1200px){.search-form__option p{max-width:110px}.search-form .search-field{border-radius:0}.search-form .search-form-suggestions-container{max-height:100vh;padding-top:40px}.search-form .search-form-suggestions-container .suggestions{max-height:100vh}.search-form .search-form-suggestions-container .suggestions__item{padding:0 10px 10px}.search-form .search-form-suggestions-container .suggestions__group{padding:5px 0}.search-form .search-form-suggestions-container .suggestions .group-title{font-family:MegaSans,Helvetica,Arial,Verdana,Tahoma,sans-serif;font-size:16px;font-weight:400;line-height:24px;padding:0 10px 15px;--mixin-calculated-line-height:24px}}.search-form.search-form_theme-rounded.search-form_size-sm .search-field-input{font-family:MegaSans,Helvetica,Arial,Verdana,Tahoma,sans-serif;font-size:14px;font-weight:400;height:34px;line-height:20px;--mixin-calculated-line-height:20px;padding:0 12px}.search-form.search-form_theme-rounded.search-form_size-sm .search-field{border-radius:8px}.search-form.search-form_theme-rounded.search-form_size-sm .search-field .search-form-clear-button,.search-form.search-form_theme-rounded.search-form_size-sm .search-field .search-form-send-button,.search-form.search-form_theme-rounded.search-form_size-sm .search-field .spinner-inline{height:34px;margin-right:5px;width:34px}"
