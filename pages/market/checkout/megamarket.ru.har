isting\":true,\"sequence\":109568,\"featureDescription\":\"\"},{\"title\":\"Модель процессора\",\"slug\":\"\",\"value\":\"5500U\",\"group\":{\"title\":\"Процессор\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":118784,\"featureDescription\":\"\"},{\"title\":\"Модель графического процессора\",\"slug\":\"\",\"value\":\"Radeon Vega 7\",\"group\":{\"title\":\"Видеокарта\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":138240,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/noutbuk-honor-magicbook-15-156-r5-8gb-512gb-dos-5301afvt-600013007046/\",\"slug\":\"noutbuk-honor-magicbook-15-156-r5-8gb-512gb-dos-5301afvt-600013007046\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":8.5,\"height\":29.5,\"length\":47,\"weightUnit\":\"кг\",\"weight\":3.059999942779541}],\"categoryId\":\"10502\",\"brand\":\"Honor\",\"contentFlags\":[],\"contentFlagsStr\":[\"matrix_smkt\"],\"stocks\":1,\"photosCount\":15,\"offersCount\":2,\"logisticTags\":[\"MGT\"],\"images\":[\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/-88/565/445/987/205/0/600013007046b0.jpeg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/-88/565/445/887/205/0/600013007046b1.jpeg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/-88/565/445/787/205/0/600013007046b2.jpeg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/-88/565/445/687/205/0/600013007046b3.jpeg\"],\"documents\":[],\"description\":\"Компактный, но мощный ноутбук Honor MagicBook 15 отлично подойдёт для повседневных и рабочих задач. Не относится к игровым моделям, но удобен для стандартного использования в офисе или дома. БЕЗ ЛИШНИХ ДЕТАЛЕЙ Лаконичный дизайн оценят любители минимализма. Серый корпус с логотипом производителя на крышке — решение в премиальном стиле. Полуматовая поверхность защищает от отпечатков пальцев и обеспечивает аккуратный вид. НАДЁЖНАЯ ЭКСПЛУАТАЦИЯ Крышка открывается без лишних усилий. При этом откидывается достаточно далеко, угол раскрытия — 150°. Вместе с отличной развесовкой и повышенной устойчивостью обеспечивается комфортное использование при любых условиях, даже если ставить девайс на колени. УДОБНАЯ КЛАВИАТУРА В девайсе предусмотрено стандартное расположение без цифрового блока. Неглубокий ход (1,4 мм) и сопротивление чуть выше среднего обеспечивают точное срабатывание. В сочетании с приятной на ощупь шершавой матовой поверхностью создаются все условия для комфортного использования. БЕЗОПАСНОСТЬ БЕЗ УСИЛИЙ Имеется встроенный сканер отпечатка пальцев, который обеспечивает мгновенную разблокировку. Это намного удобнее, чем пин-коды и пароли, к тому же можно быть уверенным в том, что никто не получит доступ к вашим данным без разрешения. НЕОБЫЧНОЕ РЕШЕНИЕ ДЛЯ ВЕБ-КАМЕРЫ Объектив спрятан не в верхней части экрана, а между кнопками F6 и F7. Имеет выдвижной механизм, который полностью исключает риск случайной видеотрансляции. Но при необходимости обеспечивается отличное качество изображения за счёт разрешения 1,3 Мп.\",\"videos\":[],\"mainCollectionId\":\"12434\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":54999,\"priceFrom\":54999,\"priceTo\":0,\"bonusPercent\":9,\"bonusAmount\":4950,\"rating\":4.9,\"reviewCount\":319,\"offerCount\":2,\"finalPrice\":54999,\"favoriteOffer\":{\"id\":\"0\",\"price\":54999,\"score\":0,\"isFavorite\":true,\"merchantId\":\"7\",\"deliveryPossibilities\":[{\"code\":\"CNC\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":false,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Самовывоз из магазина сегодня\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"finalPrice\":54999,\"bonusPercent\":9,\"bonusAmount\":4950,\"availableQuantity\":0,\"bonusAmountFinalPrice\":0,\"discounts\":[],\"priceAdjustments\":[],\"deliveryDate\":\"\",\"pickupDate\":\"\",\"merc