sk\"],\"contentFlags\":[\"theft_risk\"],\"badges\":[],\"crossedPrice\":0,\"crossedPricePeriod\":\"\",\"lastPrice\":47999,\"isAvailable\":true,\"crossedPriceChangePercentage\":0,\"collections\":[\"2755\",\"2756\",\"2757\",\"11573\",\"891042\",\"1060223\",\"12011\",\"12439\",\"12782\",\"14512\",\"16169\",\"16759\",\"16957\",\"17021\",\"17320\",\"18669\",\"615366\",\"1258450\",\"1258459\",\"1286607\",\"1286612\",\"1286621\",\"5923297\",\"6289898\",\"6289902\",\"6294516\",\"6294529\",\"9173192\",\"9823991\",\"9824016\",\"9824018\",\"9824021\",\"9824037\",\"9824039\",\"9825797\",\"9825798\",\"79999\",\"87393\",\"131855\",\"135611\",\"4016365\",\"4335011\",\"5348331\",\"6373868\",\"9816821\",\"9816822\",\"9843735\",\"9850612\",\"9861444\",\"9861461\",\"9861464\",\"9908785\",\"9993838\",\"9995292\",\"10007079\",\"10007397\",\"10039699\",\"10065610\",\"10066225\",\"10069801\",\"10073423\",\"10077374\",\"10082040\",\"10084003\",\"10085013\",\"10086244\",\"10086518\",\"10086522\",\"10089103\"],\"hasOtherOffers\":false,\"ranking\":null,\"auctionInfo\":null,\"goodsIdAlt\":\"100074495378_71024\",\"bonusAmountFinalPriceToStr\":\"\"},{\"goods\":{\"goodsId\":\"100032563494\",\"title\":\"Встраиваемый холодильник Gorenje NRKI418FP2 белый\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/-19/490/479/172/613/2/100032563494b0.jpg\",\"attributes\":[{\"title\":\"Общий объем, в литрах\",\"slug\":\"\",\"value\":\"257\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":false,\"isWebListing\":true,\"sequence\":108544,\"featureDescription\":\"\"},{\"title\":\"Компрессор\",\"slug\":\"\",\"value\":\"стандартный\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":false,\"isWebListing\":true,\"sequence\":111616,\"featureDescription\":\"\"},{\"title\":\"Габариты, в сантиметрах (ВxШxГ)\",\"slug\":\"\",\"value\":\"177,2x54x54\",\"group\":{\"title\":\"Размеры и вес\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":154624,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/vstraivaemyy-holodilnik-gorenje-nrki418fp2-belyy-100032563494/\",\"slug\":\"vstraivaemyy-holodilnik-gorenje-nrki418fp2-belyy-100032563494\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":56.400001525878906,\"height\":187.5,\"length\":58.79999923706055,\"weightUnit\":\"кг\",\"weight\":58}],\"categoryId\":\"2463684633862991\",\"brand\":\"Gorenje\",\"contentFlags\":[],\"contentFlagsStr\":[],\"stocks\":1,\"photosCount\":3,\"offersCount\":2,\"logisticTags\":[\"KGT\"],\"images\":[\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/-19/490/479/172/613/2/100032563494b0.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/-19/490/479/072/613/2/100032563494b1.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/-19/490/478/972/613/2/100032563494b2.jpg\"],\"documents\":[],\"description\":\"\\u003cp\\u003eВстраиваемый холодильник Gorenje NRKI418FP2 белого цвета отличается высокой производительностью и экономичностью.\\u003c/p\\u003e\\n\\u003ch2\\u003eСовременная техника для кухни\\u003c/h2\\u003e\\n\\u003cp\\u003eХолодильная камера оснащена системой охлаждения No Frost, благодаря чему продукты сохраняют свою свежесть длительное время. Предусмотрены 4 полки из закаленного стекла, которые легко регулируются по высоте. На дверце расположены 3 вместительных контейнера, предназначенных для хранения овощей и фруктов. Дополнительные параметры модели:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003eобъем морозильного отделения составляет 74 л;\\u003c/li\\u003e\\n\\u003cli\\u003eкласс энергопотребления – А+;\\u003c/li\\u003e\\n\\u003cli\\u003eуровень шума при работе устройства достигает 39 дБ.\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003eПрибор оснащен дисплеем, который отображает температуру внутри камер. Корпус выполнен из нержавеющей стали, что обеспечивает ему долговечность и надежность.\\u003c/p\\u003e\",\"videos\":[],\"mainCollectionId\":\"12301\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":51999,\"priceFrom\":51999,\"priceTo\":0,\"bonusPercent\":9,\"bonusAmount\":4680,\"rating\":4.8,\"reviewCount\":115,\"offerCount\":2,\"finalPrice\":51999,\"favoriteOffer\":{\"id\":\"0\",\"price\":51999,\"score\":0,\"isFavorite\":true,\"merchantId\":\"7\",\"deliveryPossibilities\":[{\"code\":\"CNC\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":false,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Самовывоз из магазина сегодня\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"finalPrice\":51999,\"bonusPercent\":9,\"bonusAmount\":4680,\"availableQuantity\":0,\"bonusAmountFinalPrice\":0,\"discounts\":[],\"priceAdjustments\":[],\"deliveryDate\":\"\",\"pickupDate\":\"\",\"merchantOfferId\":\"\",\"merchantName\":\"М.видео\",\"merchantLogoUrl\":\"\",\"merchantUrl\":\"\",\"merchantSummaryRating\":0,\"isBpgByMerchant\":false,\"nds\":0,\"oldPrice\":0,\"oldPriceChangePercentage\":0,\"maxDeliveryDays\":null,\"bpgType\":\"UNKNOWN_BPG_TYPE\",\"creditPaymentAmount\":0,\"installmentPaymentAmount\":0,\"showMerchant\":null,\"salesBlockInfo\":null,\"dueDate\":\"COLLECT_TODAY_OFFER_DUE_DATE\",\"dueDateText\":\"\",\"locationId\":\"\",\"spasiboIsAvailable\":false,\"isShowcase\":false,\"loyaltyPromotionFlags\":[],\"pricesPerMeasurement\":[],\"availablePaymentMethods\":[],\"superPrice\":0,\"warehouseId\":\"\",\"bnplPaymentParams\":null,\"installmentPaymentParams\":null,\"bonusInfoGroups\":[],\"calculatedDeliveryDate\":\"Сегодня\",\"goodsId\":\"\",\"typeFilters\":[],\"goodsSlug\":\"\",\"fastPurchaseOptions\":null,\"bonusAmountFinalPriceToStr\":\"\",\"tags\":[],\"goodsIdAlt\":\"\"},\"relatedItems\":[],\"productSelectors\":[],\"extraOptions\":[],\"deliveryPossibilities\":[{\"code\":\"CNC\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":false,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Самовывоз из магазина сегодня\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"discounts\":[],\"contentFlagsStr\":[],\"contentFlags\":[],\"badges\":[],\"crossedPrice\":0,\"crossedPricePeriod\":\"\",\"lastPrice\":55999,\"isAvailable\":true,\"crossedPriceChangePercentage\":0,\"collections\":[\"2071\",\"2119\",\"2155\",\"2156\",\"3567\",\"3568\",\"12028\",\"12043\",\"12049\",\"12111\",\"12301\",\"12782\",\"2228642\",\"221503\",\"221905\",\"1711824\",\"8226437\",\"21885\",\"99464\",\"151832\",\"152327\",\"155554\",\"2228702\",\"4009367\",\"4335011\",\"4339059\",\"8387053\",\"9099066\",\"9816828\",\"9843735\",\"9850612\",\"9861437\",\"9861461\",\"9861464\",\"9993822\",\"10007079\",\"10007397\",\"10065609\",\"10065786\",\"10069801\",\"10073425\",\"10077374\",\"10084566\",\"10085005\",\"10089103\"],\"hasOtherOffers\":false,\"ranking\":null,\"auctionInfo\":null,\"goodsIdAlt\":\"100032563494_7\",\"bonusAmountFinalPriceToStr\":\"\"},{\"goods\":{\"goodsId\":\"100029989739\",\"title\":\"Телевизор Haier H65S9UG PRO, 65\\\"(165 см), UHD 4K\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/565/014/999/127/184/2/100029989739b0.jpg\",\"attributes\":[],\"webUrl\":\"https://megamarket.ru/catalog/details/televizor-haier-h65s9ug-pro-100029989739/\",\"slug\":\"televizor-haier-h65s9ug-pro-100029989739\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":95.5,\"height\":18.5,\"length\":160,\"weightUnit\":\"кг\",\"weight\":31.700000762939453}],\"categoryId\":\"2463684633791462\",\"brand\":\"Haier\",\"contentFlags\":[],\"contentFlagsStr\":[],\"stocks\":1,\"photosCount\":7,\"offersCount\":3,\"logisticTags\":[\"KGT\"],\"images\":[\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/565/014/999/127/184/2/100029989739b0.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/565/015/000/127/184/2/100029989739b1.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/565/015/001/127/184/2/100029989739b2.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/565/015/002/127/184/2/100029989739b3.jpg\"],\"documents\":[\"https://main-cdn.sbermegamarket.ru/hlr-system/181/359/105/712/718/42/100029989739bi01.pdf\"],\"description\":\"\\u003cp\\u003eУникальный телевизор Haier H65S9UG PRO, 65\\\"(165 см), UHD 4K обеспечит вам непревзойденное качество изображения и удивительную четкость. С его помощью вы окунетесь в мир ярких эмоций и насладитесь просмотром любимых фильмов и сериалов прямо у себя дома.\\u003c/p\\u003e\\n\\n\\u003ch2\\u003eНевероятная четкость изображения\\u003c/h2\\u003e\\n\\n\\u003cp\\u003eГлавной особенностью телевизора Haier H65S9UG PRO является его разрешение экрана UHD 4K (3840x2160 пикселей). Благодаря своей передовой OLED-технологии, этот телевизор обеспечивает непревзойденную глубину черного цвета и максимально точную передачу цветов. Каждая деталь на экране оживает и становится реалистичной, создавая потрясающий эффект присутствия.\\u003c/p\\u003e\\n\\n\\u003col\\u003e\\n\\u003cli\\u003eБольшой размер экрана 65\\\" (165 см) позволяет вам полностью погрузиться в происходящее на экране.\\u003c/li\\u003e\\n\\u003cli\\u003eВысокая частота обновления экрана - 120 Гц, предотвращает размытие движущихся объектов, обеспечивая четкость и плавность изображения.\\u003c/li\\u003e\\n\\u003cli\\u003eПоддержка HDR и улучшение изображения HDR10 позволяют вам насладиться более реалистичными и яркими цветами, что добавляет глубину и объемности вашему просмотру.\\u003c/li\\u003e\\n\\u003cli\\u003eВстроенный голосовой помощник Google Assistant позволяет легко управлять телевизором с помощью голосовых команд. Это удобно и интуитивно понятно.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\n\\u003cp\\u003eКроме того, телевизор Haier H65S9UG PRO имеет функцию беспроводного подключения Wi-Fi и Bluetooth, что позволяет с легкостью подключать его к другим устройствам, таким как смартфоны или наушники. Также он оснащен полезными функциями, такими как множество портов HDMI и USB для подключения дополнительных устройств и операционной системой Android, которая открывает двери в мир развлечений на большом экране.\\u003c/p\\u003e\",\"videos\":[],\"mainCollectionId\":\"15943\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":104636,\"priceFrom\":65999,\"priceTo\":0,\"bonusPercent\":0,\"bonusAmount\":0,\"rating\":4.8,\"reviewCount\":221,\"offerCount\":3,\"finalPrice\":104636,\"favoriteOffer\":{\"id\":\"0\",\"price\":104636,\"score\":0,\"isFavorite\":true,\"merchantId\":\"34069\",\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"finalPrice\":104636,\"bonusPercent\":0,\"bonusAmount\":0,\"availableQuantity\":0,\"bonusAmountFinalPrice\":0,\"discounts\":[],\"priceAdjustments\":[],\"deliveryDate\":\"\",\"pickupDate\":\"\",\"merchantOfferId\":\"\",\"merchantName\":\"Electronicexpress\",\"merchantLogoUrl\":\"\",\"merchantUrl\":\"\",\"merchantSummaryRating\":0,\"isBpgByMerchant\":false,\"nds\":0,\"oldPrice\":0,\"oldPriceChangePercentage\":0,\"maxDeliveryDays\":null,\"bpgType\":\"UNKNOWN_BPG_TYPE\",\"creditPaymentAmount\":0,\"installmentPaymentAmount\":0,\"showMerchant\":null,\"salesBlockInfo\":null,\"dueDate\":\"DEFAULT_DELIVERY_OFFER_DUE_DATE\",\"dueDateText\":\"\",\"locationId\":\"\",\"spasiboIsAvailable\":false,\"isShowcase\":false,\"loyaltyPromotionFlags\":[],\"pricesPerMeasurement\":[],\"availablePaymentMethods\":[],\"superPrice\":0,\"warehouseId\":\"651704\",\"bnplPaymentParams\":null,\"installmentPaymentParams\":