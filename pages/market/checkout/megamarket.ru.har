height\":35.5,\"length\":44,\"weightUnit\":\"кг\",\"weight\":8.170000076293945}],\"categoryId\":\"2463684633816975\",\"brand\":\"Tefal\",\"contentFlags\":[],\"contentFlagsStr\":[],\"stocks\":1,\"photosCount\":13,\"offersCount\":4,\"logisticTags\":[],\"images\":[\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/171/273/789/912/121/78/600023456579b0.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/171/273/790/012/121/78/600023456579b1.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/171/273/790/142/111/30/600023456579b2.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/171/273/790/212/121/78/600023456579b3.jpg\"],\"documents\":[],\"description\":\"\\u003cp\\u003eОт домашней пиццы с хрустящей корочкой до нежной рыбы и аппетитного мяса  аэрогриль Easy Fry Mega приготовит вкусные и сбалансированные блюда для всей вашей семьи или большой компании друзей. Несмотря на свой компактный формат, этот функциональный аэрогриль оснащен глубокой чашей с антипригарным покрытием, которая вмешает до 8 порций блюд и пригодна для мытья в посудомоечной машине. Точные настройки температуры и времени, а также 8 автоматических программ гарантируют идеальный результат вне зависимости от выбранного рецепта. А с приложением My Tefal планирование ежедневного меню станет вашим любимым занятием!\\u003c/p\\u003e\\u003cp\\u003e\\u003c/p\\u003e\\u003cp\\u003eИдеальный объем для большой компании\\u003c/p\\u003e\\u003cp\\u003eПорадуйте сытными и вкусными блюдами всех, кого вы любите, с помощью аэрогриля, оснащенного чашей объемом 7,5 л на 8 порций.\\u003c/p\\u003e\\u003cp\\u003e\\u003c/p\\u003e\\u003cp\\u003eКомпактный дизайн\\u003c/p\\u003e\\u003cp\\u003eВместительный аэрогриль в компактном корпусе не займет много места на вашей кухне.\\u003c/p\\u003e\\u003cp\\u003e\\u003c/p\\u003e\\u003cp\\u003eТочное приготовление\\u003c/p\\u003e\\u003cp\\u003e8 автоматических программ + точный контроль температуры и времени (от 80°C до 200°C, до 60 минут) гарантируют идеальный результат вне зависимости от выбранного вами рецепта.\\u003c/p\\u003e\\u003cp\\u003e\\u003c/p\\u003e\\u003cp\\u003eСбалансированное меню\\u003c/p\\u003e\\u003cp\\u003eОт домашней пиццы с хрустящей корочкой до аппетитного лосося  с легкостью готовьте вкусные и полезные блюда, перед которыми не устоит никто!\\u003c/p\\u003e\\u003cp\\u003e\\u003c/p\\u003e\\u003cp\\u003eЛегко чистить\\u003c/p\\u003e\\u003cp\\u003eЧаша с антипригарным покрытием проста в уходе и позволяет готовить блюда с исключительным комфортом.\\u003c/p\\u003e\",\"videos\":[],\"mainCollectionId\":\"307179\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":14799,\"priceFrom\":14799,\"priceTo\":0,\"bonusPercent\":40,\"bonusAmount\":5920,\"rating\":5,\"reviewCount\":11,\"offerCount\":4,\"finalPrice\":14799,\"favoriteOffer\":{\"id\":\"0\",\"price\":14799,\"score\":0,\"isFavorite\":true,\"merchantId\":\"245053\",\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"finalPrice\":14799,\"bonusPercent\":40,\"bonusAmount\":5920,\"availableQuantity\":0,\"bonusAmountFinalPrice\":0,\"discounts\":[],\"priceAdjustments\":[],\"deliveryDate\":\"\",\"pickupDate\":\"\",\"merchantOfferId\":\"\",\"merchantName\":\"Официальный магазин Tefal\",\"merchantLogoUrl\":\"\",\"merchantUrl\":\"\",\"merchantSummaryRating\":0,\"isBpgByMerchant\":false,\"nds\":0,\"oldPrice\":24990,\"oldPriceChangePercentage\":-41,\"maxDeliveryDays\":null,\"bpgType\":\"UNKNOWN_BPG_TYPE\",\"creditPaymentAmount\":0,\"installmentPaymentAmount\":0,\"showMerchant\":null,\"salesBlockInfo\":null,\"dueDate\":\"DEFAULT_DELIVERY_OFFER_DUE_DATE\",\"dueDateText\":\"\",\"locationId\":\"\