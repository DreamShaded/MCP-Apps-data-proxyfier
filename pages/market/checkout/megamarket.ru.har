],\"deliveryDate\":\"\",\"pickupDate\":\"\",\"merchantOfferId\":\"\",\"merchantName\":\"М.видео\",\"merchantLogoUrl\":\"\",\"merchantUrl\":\"\",\"merchantSummaryRating\":0,\"isBpgByMerchant\":false,\"nds\":0,\"oldPrice\":0,\"oldPriceChangePercentage\":0,\"maxDeliveryDays\":null,\"bpgType\":\"UNKNOWN_BPG_TYPE\",\"creditPaymentAmount\":0,\"installmentPaymentAmount\":0,\"showMerchant\":null,\"salesBlockInfo\":null,\"dueDate\":\"COLLECT_TODAY_OFFER_DUE_DATE\",\"dueDateText\":\"\",\"locationId\":\"\",\"spasiboIsAvailable\":false,\"isShowcase\":false,\"loyaltyPromotionFlags\":[],\"pricesPerMeasurement\":[],\"availablePaymentMethods\":[],\"superPrice\":0,\"warehouseId\":\"\",\"bnplPaymentParams\":null,\"installmentPaymentParams\":null,\"bonusInfoGroups\":[],\"calculatedDeliveryDate\":\"Сегодня\",\"goodsId\":\"\",\"typeFilters\":[],\"goodsSlug\":\"\",\"fastPurchaseOptions\":null,\"bonusAmountFinalPriceToStr\":\"\",\"tags\":[],\"goodsIdAlt\":\"\"},\"relatedItems\":[],\"productSelectors\":[],\"extraOptions\":[],\"deliveryPossibilities\":[{\"code\":\"CNC\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":false,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Самовывоз из магазина сегодня\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"discounts\":[],\"contentFlagsStr\":[],\"contentFlags\":[],\"badges\":[],\"crossedPrice\":0,\"crossedPricePeriod\":\"\",\"lastPrice\":20999,\"isAvailable\":true,\"crossedPriceChangePercentage\":0,\"collections\":[\"2118\",\"2128\",\"3063\",\"884988\",\"924527\",\"924528\",\"12011\",\"12191\",\"12203\",\"12782\",\"1705324\",\"1705327\",\"1705328\",\"6597349\",\"6597354\",\"6597381\",\"6597398\",\"7307726\",\"7641042\",\"8107881\",\"8107923\",\"8844753\",\"10047254\",\"10047264\",\"10047267\",\"10047272\",\"10047282\",\"10047284\",\"10047286\",\"10047293\",\"10047300\",\"10047305\",\"10047323\",\"10047324\",\"10047329\",\"10047330\",\"10047349\",\"10047350\",\"10047351\",\"10047352\",\"10047362\",\"10047391\",\"10047392\",\"10047396\",\"10047406\",\"10047416\",\"10047427\",\"10047435\",\"10047463\",\"10047468\",\"1855986\",\"1856267\",\"3859028\",\"4008279\",\"4335011\",\"9850612\",\"9861461\",\"9861464\",\"9995291\",\"10007079\",\"10007397\",\"10065786\",\"10069801\",\"10073422\",\"10077374\",\"10082040\",\"10085002\",\"10086522\",\"10089103\"],\"hasOtherOffers\":false,\"ranking\":null,\"auctionInfo\":null,\"goodsIdAlt\":\"100074810794_7\",\"bonusAmountFinalPriceToStr\":\"\"},{\"goods\":{\"goodsId\":\"100000028198\",\"title\":\"Кофемашина автоматическая DeLonghi ETAM 29.660.SB\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/475/791/879/610/162/8/100000028198b0.jpeg\",\"attributes\":[{\"title\":\"Давление помпы\",\"slug\":\"\",\"value\":\"15 Бар\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":107520,\"featureDescription\":\"\"},{\"title\":\"Потребляемая мощность, в Вт\",\"slug\":\"\",\"value\":\"1450\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":108544,\"featureDescription\":\"\"},{\"title\":\"Объем резервуара для воды, в литрах\",\"slug\":\"\",\"value\":\"1.4\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":112640,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/kofemashina-avtomaticheskaya-delonghi-etam-29-660-sb-100000028198/\",\"slug\":\"kofemashina-avtomaticheskaya-delonghi-etam-29-660-sb-100000028198\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":60,\"height\":49,\"length\":27,\"weightUnit\":\"кг\",\"weight\":13.5}],\"categoryId\":\"2463684633832141\",\"brand\":\"Delonghi\",\"contentFlags\":[],\"contentFlagsStr\":[\"matrix_smkt\"],\"stocks\":1,\"photosCount\":10,\"offersCount\":1,\"logisticTags\":[\"MGT\"],\"images\":[\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/475/791/879/610/162/8/100000028198b0.jpeg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/475/791/880/610/162/8/100000028198b1.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/475/791/881/610/162/9/100000028198b2.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/475/791/882/610/162/9/100000028198b3.jpg\"],\"documents\":[],\"description\":\"\\u003cbr\\u003eАвтоматическая кофемашина De'Longhi ETAM 29.660.SB готовит эспрессо (одновременно можно заварить две чашки), капучино, латте макиато, флэт уайт, подогревает молоко – всего в эту модель заложено восемь рецептов.   Количество горячей воды, крепость и плотность пены регулируются. Сенсорная панель управления удобно расположена на передней части корпуса. Дисплей оснащен понятными пиктограммами и отображает все активные установки.  Коническая кофемолка, снабженная металлическими жерновами, позволяет регулировать степень помола. Контейнер для зерен вмещает 150 г. Объем резервуара для воды – 1,4 л, так что вы приготовите несколько порций для всех членов семьи, не прерываясь на добавление жидкости.  Уход за прибором упрощает автоматическое ополаскивание системы подачи молока. Заварочный блок съемный – его легко промыть под струей воды. Снимается и поддон для сбора капель. Кофемашина предупредит о необходимости провести цикл очистки от накипи.  Эту модель можно запрограммировать на автоматическое включение в определенное время: например, чтобы к завтраку уже был готов горячий кофе. Задается и автоотключение: устройство может прекратить работу через 15 или 30 минут, 1, 2 или 3 часа бездействия.\",\"videos\":[],\"mainCollectionId\":\"12661\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":124240,\"priceFrom\":124240,\"priceTo\":0,\"bonusPercent\":0,\"bonusAmount\":0,\"rating\":4.9,\"reviewCount\":438,\"offerCount\":1,\"finalPrice\":110698,