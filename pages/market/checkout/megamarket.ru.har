            "text": ".geolocation-disclaimer{background-color:var(--pui-bg-layer-01, );border-radius:16px;display:flex;flex-direction:column;justify-content:center;padding:16px 40px 16px 48px;position:relative;width:288px}.geolocation-disclaimer__alert-icon{background:50%/contain no-repeat url(/static/dist/images/info-violet.4e0123.svg);height:20px;left:16px;position:absolute;top:16px;width:20px}.geolocation-disclaimer__title{font-weight:500}.geolocation-disclaimer__description,.geolocation-disclaimer__title{font-family:MegaSans,Helvetica,Arial,Verdana,Tahoma,sans-serif;font-size:12px;line-height:16px;--mixin-calculated-line-height:16px}.geolocation-disclaimer__description{font-weight:400;margin-top:4px}.geolocation-disclaimer__submit{margin-top:20px;width:87px}.geolocation-disclaimer__close-btn{position:absolute;right:8px;top:8px}.geolocation-disclaimer__close-btn .svg-icon{color:var(--pui-text-tertiary, );height:24px;width:24px}.geolocation-disclaimer__close-btn .svg-icon:hover{color:var(--pui-text-secondary, )}@media (min-width:1201px){.geolocation-disclaimer{padding:24px 16px;width:500px}.geolocation-disclaimer__title{font-family:MegaSans,Helvetica,Arial,Verdana,Tahoma,sans-serif;font-size:18px;font-weight:700;line-height:26px;--mixin-calculated-line-height:26px}.geolocation-disclaimer__description{font-family:MegaSans,Helvetica,Arial,Verdana,Tahoma,sans-serif;font-size:14px;font-weight:400;line-height:20px;margin-right:10px;margin-top:8px;--mixin-calculated-line-height:20px}.geolocation-disclaimer__close-btn{right:6px;top:6px}}.gis-map-container{position:relative;z-index:0}.gis-map-container,.gis-map-container .gis-map{height:100%;width:100%}.gis-map-container__balloon,.gis-map-container__controls{bottom:0;display:flex;left:0;pointer-events:none;position:absolute;right:0;top:0;z-index:3}.gis-map-container__controls{align-items:center;justify-content:flex-end;padding:8px}.gis-map-container__controls button{pointer-events:auto}.gis-map-container .gis-map-balloon{max-height:100%;position:relative}.gis-map-container .gis-map-balloon>*{pointer-events:auto}@media (min-width:1201px){.gis-map-container .gis-map-balloon{padding:8px}}@media (max-width:1200px){.gis-map-container__balloon{align-items:flex-end}.gis-map-container .gis-map-balloon{width:100%}}"
