            "text": ".pickup-point-info__icon{background-size:15px;display:inline-block;height:15px;width:15px}.pp-display{display:flex;gap:12px}.pp-display__logo{flex-shrink:0;height:40px;margin:4px 0;width:40px}.pp-display__description{font-family:MegaSans,Helvetica,Arial,Verdana,Tahoma,sans-serif;font-size:16px;font-weight:400;line-height:24px;--mixin-calculated-line-height:24px;display:flex;flex:1;flex-direction:column}.pp-display__info{color:var(--pui-text-secondary, )}.pp-display__name{align-items:center;display:flex;gap:4px}.pp-display__about,.pp-display__change{color:var(--pui-text-secondary, );cursor:pointer}.geo-selector-search{flex:1 1 auto;position:relative}.geo-selector-search .geo-selector-search__field{border-radius:10px;overflow:hidden}.geo-selector-search .geo-selector-search__field_error{border-color:var(--pui-feedback-border-danger, )}.geo-selector-search .geo-selector-search__input{background:var(--pui-bg-layer-01, );border:none;border-radius:2px;display:block;font-family:MegaSans,Helvetica,Arial,Verdana,Tahoma,sans-serif;font-size:14px;font-weight:400;height:36px;line-height:20px;padding-left:15px;width:100%;--mixin-calculated-line-height:20px}@media (min-width:1201px){.geo-selector-search .search-form-send-button{height:34px;width:34px}.geo-selector-search .search-field input{height:34px}.geo-selector-search .search-field input::placeholder{color:var(--pui-text-tertiary, )}.geo-selector-search .search-field .spinner-inline{height:34px;width:34px}}.geo-selector-saf-desktop{align-items:center;display:flex;justify-content:space-between;width:100%}.geo-selector-saf-desktop__dropdown{width:100%}.geo-selector-saf-desktop__dropdown .caret{color:var(--pui-text-disabled, );height:18px;width:18px}.geo-selector-saf-desktop__dropdown .geo-selector-saf-desktop-multiselect{position:relative;width:100%;z-index:3}.geo-selector-saf-desktop__dropdown .geo-selector-saf-desktop-multiselect__header{display:flex;font-family:MegaSans,Helvetica,Arial,Verdana,Tahoma,sa