ptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"discounts\":[],\"contentFlagsStr\":[\"matrix_smkt\"],\"contentFlags\":[],\"badges\":[],\"crossedPrice\":0,\"crossedPricePeriod\":\"\",\"lastPrice\":0,\"isAvailable\":true,\"crossedPriceChangePercentage\":0,\"collections\":[\"2174\",\"2225\",\"2287\",\"884988\",\"945214\",\"4757746\",\"12011\",\"12081\",\"12782\",\"269183\",\"2428408\",\"295700\",\"887324\",\"887388\",\"2431119\",\"4017614\",\"9208595\",\"9808672\",\"9861461\",\"10044469\",\"10049067\",\"10049068\",\"10082040\"],\"hasOtherOffers\":false,\"ranking\":null,\"auctionInfo\":null,\"goodsIdAlt\":\"700006555710_264151\",\"bonusAmountFinalPriceToStr\":\"\"},{\"goods\":{\"goodsId\":\"600020192898\",\"title\":\"SUP-борд UNIX Line Голубая лагуна / Blue Lagoon (320 см)\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/105/003/029/155/151/2/600020192898b0.jpg\",\"attributes\":[{\"title\":\"Вид доски\",\"slug\":\"\",\"value\":\"прогулочная; для йоги; для рыбалки; туринговая\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":109568,\"featureDescription\":\"\"},{\"title\":\"Длина, ft\",\"slug\":\"\",\"value\":\"11\",\"group\":{\"title\":\"Размеры и вес\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":120832,\"featureDescription\":\"\"},{\"title\":\"Ширина, см\",\"slug\":\"\",\"value\":\"81\",\"group\":{\"title\":\"Размеры и вес\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":121856,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/sup-bord-unix-line-golubaya-laguna-blue-lagoon-320-sm-600020192898/\",\"slug\":\"sup-bord-unix-line-golubaya-laguna-blue-lagoon-320-sm-600020192898\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":33,\"height\":25,\"length\":85,\"weightUnit\":\"кг\",\"weight\":11}],\"categoryId\":\"2463684633834817\",\"brand\":\"UNIXline\",\"contentFlags\":[],\"contentFlagsStr\":[],\"stocks\":1,\"photosCount\":15,\"offersCount\":1,\"logisticTags\":[],\"images\":[\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/105/003/029/155/151/2/600020192898b0.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/105/003/029/255/151/2/600020192898b1.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/105/003/029/355/151/2/600020192898b2.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/105/003/029/455/151/2/600020192898b3.jpg\"],\"documents\":[\"https://main-cdn.sbermegamarket.ru/hlr-system/-23/814/859/531/814/48/600020192898bi01.pdf\"],\"description\":\"Сапборд UNIX Line - идеальное сочетание активного отдыха и спокойного времяпрепровождения на воде! Надувной двухслойный SUP-борд станет вашим верным спутником в любых приключениях на воде! Прогулочная САП-доска предназначена для катания как на высокой волне, так и на спокойной глади. Высокие стандарты качества обеспечивают устойчивость, жесткость, долговечность и портативность. Идеально подойдет не только для опытных райдеров, но и для новичков. SUP-борд доска обладает исключительной прочностью и легкостью, благодаря использованию высококачественных материалов. Уникальная конструкция доски обеспечивает стабильность и управляемость даже в самых непредсказуемых условиях.Сочетание эргономичного дизайна и передовых технологий делает SUP-доску идеальным выбором как для начинающих любителей SUP-серфинга, так и для опытных профессионалов. Легко надувается и быстро собирается, что позволяет вам быстро выйти на воду и наслаждаться каждым мгновением.Большое количество ярких дизайнов позволит выбрать надувную доску, которая подчеркнет вашу индивидуальность и будет мотивировать вас к новым свершениям!Почувствуйте себя свободным с безопасным и стильным SUP-бордом от UNIX Line, наслаждаясь кристально чистой водой и живописными пейзажами!\",\"videos\":[],\"mainCollectionId\":\"855777\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":93760,\"priceFrom\":93760,\"priceTo\":0,\"bonusPercent\":37,\"bonusAmount\":5513,\"rating\":4.6,\"reviewCount\":35,\"offerCount\":1,\"finalPrice\":14900,\"favoriteOffer\":{\"id\":\"0\",\"price\":93760,\"score\":0,\"isFavorite\":true,\"merchantId\":\"111363\",\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"finalPrice\":14900,\"bonusPercent\":37,\"bonusAmount\":5513,\"availableQuantity\":0,\"bonusAmountFinalPrice\":0,\"discounts\":[],\"priceAdjustments\":[],\"deliveryDate\":\"\",\"pickupDate\":\"\",\"merchantOfferId\":\"\",\"merchantName\":\"Юникс-Фитнес DBS\",\"merchantLogoUrl\":\"\",\"merchantUrl\":\"\",\"merchantSummaryRating\":0,\"isBpgByMerchant\":false,\"nds\":0,\"oldPrice\":93760,\"oldPriceChangePercentage\":-84,\"maxDeliveryDays\":null,\"bpgType\":\"UNKNOWN_BPG_TYPE\",\"creditPaymentAmount\":0,\"installmentPaymentAmount\":0,\"showMerchant\":null,\"salesBlockInfo\":null,\"dueDate\":\"DEFAULT_DELIVERY_OFFER_DUE_DATE\",\"dueDateText\":\"\",\"locationId\":\"\",\"spasiboIsAvailable\":false,\"isShowcase\":false,\"loyaltyPromotionFlags\":[],\"pricesPerMeasurement\":[],\"availablePaymentMethods\":[],\"superPrice\":0,\"warehouseId\":\"2844546\",\"bnplPaymentParams\":null,\"installmentPaymentParams\":null,\"bonusInfoGroups\":[],\"calculatedDeliveryDate\":\"Завтра\",\"goodsId\":\"\",\"typeFilters\":[],\"goodsSlug\":\"\",\"fastPurchaseOptions\":null,\"bonusAmountFinalPriceToStr\":\"\",\"tags\":[],\"goodsIdAlt\":\"\"},\"relatedItems\":[],\"productSelectors\":[],\"extraOptions\":[],\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"discounts\":[],\"contentFlagsStr\":[],\"contentFlags\":[],\"badges\":[{\"title\":\"\",\"tooltip\":\"\",\"data\":{\"type\":\"\",\"percent\":0,\"image\":\"https://main-cdn.sbermegamarket.ru/upload/mnt/2b47e0e5-8347-42bc-8d86-381fb28c6048.png\",\"color\":\"\",\"merchantId\":\"0\",\"merchantName\":\"\",\"placeId\":\"400000030\",\"merchantIds\":[\"111363\"]}},{\"title\":\"\",\"tooltip\":\"\",\"data\":{\"type\":\"\",\"percent\":0,\"image\":\"https://main-cdn.sbermegamarket.ru/upload/mnt/b91aadf9-abc7-434d-9269-276858bd54d8.png\",\"color\":\"\",\"merchantId\":\"0\",\"merchantName\":\"\",\"placeId\":\"400000010\",\"merchantIds\":[\"111363\"]}}],\"crossedPrice\":0,\"crossedPricePeriod\":\"\",\"lastPrice\":29890,\"isAvailable\":true,\"crossedPriceChangePercentage\":0,\"collections\":[\"5780\",\"5859\",\"6223\",\"640439\",\"640444\",\"640447\",\"12029\",\"12782\",\"14900\",\"16041\",\"855776\",\"855777\",\"4755632\",\"7057388\",\"7057401\",\"7096089\",\"9795786\",\"9795795\",\"5385414\",\"5515173\",\"8096433\",\"8097352\",\"8098133\",\"8098135\",\"4025374\",\"4336047\",\"4368028\",\"4586792\",\"9788535\",\"9816822\",\"9816825\",\"9900746\",\"10007079\",\"10067859\",\"10069801\",\"10072836\",\"10074460\",\"10077375\",\"10077376\",\"10077386\",\"10079911\",\"10079914\",\"10082129\",\"10084000\",\"10085001\",\"10085015\",\"10085038\",\"10085360\",\"10085554\",\"10086244\",\"10089103\"],\"hasOtherOffers\":false,\"ranking\":null,\"auctionInfo\":null,\"goodsIdAlt\":\"600020192898_111363\",\"bonusAmountFinalPriceToStr\":\"\"},{\"goods\":{\"goodsId\":\"600023549368\",\"title\":\"Кресло Barneo K-152 серый пластик, серая сетка, 6D подлокотники\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/-16/429/130/843/231/30/600023549368b0.jpg\",\"attributes\":[{\"title\":\"Максимальная нагрузка, кг\",\"slug\":\"\",\"value\":\"150\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":118784,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/kreslo-barneo-k-152-seryy-plastik-seraya-setka-6d-podlokotniki-600023549368/\",\"slug\":\"kreslo-barneo-k-152-seryy-plastik-seraya-setka-6d-podlokotniki-600023549368\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":38,\"height\":65,\"length\":68,\"weightUnit\":\"кг\",\"weight\":22.950000762939453}],\"categoryId\":\"2463684633838764\",\"brand\":\"Barneo\",\"contentFlags\":[],\"contentFlagsStr\":[],\"stocks\":1,\"photosCount\":15,\"offersCount\":1,\"logisticTags\":[],\"images\":[\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/-16/429/130/843/231/30/600023549368b0.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/-16/429/130/833/231/30/600023549368b1.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/-16/429/130/823/231/30/600023549368b2.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/-16/429/130/813/231/30/600023549368b3.jpg\"],\"documents\":[],\"description\":\"Кресло Barneo K-152 серый пластик, серая сетка, 6D подлокотники, с выдвижной подставкой для ног - революция в мире эргономичной мебели, созданная для тех, кто уделяет особое внимание своему здоровью и комфорту. Это идеальное кресло для продолжительной работы, которое превратит ваши будни в настоящую сказку. Подставка для ног позволит минимизировать нагрузку на мышцы спины , улучшив самочувствие и производительность. Гарантия 12 месяцев.\\u003cbr\\u003e \\u003cbr\\u003e \\u003cu\\u003eКлючевые особенности:\\u003c/u\\u003e\\u003cbr\\u003e \\u003cul\\u003e\\u003cli\\u003e Механизм регулировки угла наклона спинки - помогает поддерживать здоровый тонус спины.\\u003c/li\\u003e \\u003cli\\u003e Выдвижная подставка для ног - отдыхайте в любом положении.\\u003c/li\\u003e \\u003cli\\u003e Технология 6D подлокотников - возможность регулировки по высоте, глубине, и углу поворота, открывающая новые горизонты для индивидуальной настройки кресла под личные предпочтения.\\u003c/li\\u003e \\u003cli\\u003e Поясничная и шейная поддержка - снижение нагрузки на позвоночник.\\u003c/li\\u003e \\u003cli\\u003e Регулируемая высота (45-51 см) - адаптация под любой стол и индивидуальные предпочтения.\\u003c/li\\u003e \\u003cli\\u003e Прочная обивка - дышащая, гипоаллергенная и чрезвычайно комфортная, обеспечивая идеальную циркуляцию воздуха.\\u003c/li\\u003e \\u003cbr\\u003e \\u003cu\\u003eТехнические параметры:\\u003c/u\\u003e\\u003cbr\\u003e Поставляется в разобранном виде\\u003cbr\\u003e Материал сиденья: сетчатая ткань\\u003cbr\\u003e Настройка подлокотников: 6D\\u003cbr\\u003e Ширина подлокотников, см.: 10\\u003cbr\\u003e Материал крестовины: хромированный металл\\u003cbr\\u003e Кресло снабжено поворотно-подъемным механизмом газлифт 4кл\\u003cbr\\u003e Механизм качания: отсутствует\\u003cbr\\u003e Механизм регулировки угла наклона спинки: есть\\u003cbr\\u003e Механизм регулировки высоты спинки: есть\\u003cbr\\u003e Регулировка подголовника: есть\\u003cbr\\u003e Выдвижная подставка для ног: есть\\u003cbr\\u003e Размеры сиденья внутренние Ш*Г, см.: 50*52\\u003cbr\\u003e Размеры стула общие Ш*Г, см.: 71*73\\u003cbr\\u003e Высота сиденья от пола, см.: 45-51\\u003cbr\\u003e Высота стула общая, см.: 110 (124) -118 (132)\\u003cbr\\u003e Высота спинки, см.: 71-85\\u003cbr\\u003e Диаметр крестовины, см.: 68\\u003cbr\\u003e Ролики нейлон прорезиненные (для ламината и паркета), мм.: 60\\u003cbr\\u003e Вес кресла нетто, кг.: 20.95\\u003cbr\\u003e \\u003cu\\u003eУсловия эксплуатации:\\u003c/u\\u003e\\u003cbr\\u003e Температура: от 0°С до +35°С.\\u003cbr\\u003e Влажность: до 80%.\\u003cbr\\u003e Нагрузка до 150 кг.\\u003cbr\\u003e \\u003cbr\\u003e Закажите кресло Barneo K-152 - это инвестиция в ваше здоровье или здоровье Ваших сотрудников, максимальные продуктивность и комфорт. Стильный серый дизайн, инновационные 6D подлокотники и продуманная эргономика делают это кресло лидером в своем классе.\\u003cbr\\u003e\",\"videos\":[],\"mainCollectionId\":\"12667\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":20990,\"priceFrom\":20990,\"priceTo\":0,\"bonusPercent\":15,\"bonusAmount\":2494,\"rating\":5,\"reviewCount\":10,\"offerCount\":1,\"finalPrice\":16624,\"favoriteOffer\":{\"id\":\"0\",\"price\":20990,\"score\":0,\"isFavorite\":true,\"merchantId\":\"22131\",\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"finalPrice\":16624,\"bonusPercent\":15,\"bonusAmount\":2494,\"availableQuantity\":0,\"bonusAmountFinalPrice\":0,\"discounts\":[],\"priceAdjustments\":[],\"deliveryDate\":\"\",\"pickupDate\":\"\",\"merchantOfferId\":\"\",\"merchantName\":\"ИП Будилов Виктор Викторович\",\"merchantLogoUrl\":\"\",\"merchantUrl\":\"\",\"merchantSummaryRating\":0,\"isBpgByMerchant\":false,\"nds\":0,\"oldPrice\":20990,\"oldPriceChangePercentage\":-21,\"maxDeliveryDays\":null,\"bpgType\":\"UNKNOWN_BPG_TYPE\",\"creditPaymentAmount\":0,\"installmentPaymentAmount\":0,\"showMerchant\":null,\"salesBlockInfo\":null,\"dueDate\":\"DEFAULT_DELIVERY_OFFER_DUE_DATE\",\"dueDateText\":\"\",\"locationId\":\"\",\"spasiboIsAvailable\":false,\"isShowcase\":false,\"loyaltyPromotionFlags\":[],\"pricesPerMeasurement\":[],\"availablePaymentMethods\":[],\"superPrice\":0,\"warehouseId\":\"623007\",\"bnplPaymentParams\":null,\"installmentPaymentParams\":null,\"bonusInfoGroups\":[],\"calculatedDeliveryDate\":\"22 июля\",\"goodsId\":\"\",\"typeFilters\":[],\"goodsSlug\":\"\",\"fastPurchaseOptions\":null,\"b