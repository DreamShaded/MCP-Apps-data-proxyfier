tFinalPriceToStr\":\"\"},\"visualType\":\"A\",\"side\":\"LEFT\"},{\"type\":\"ITEM\",\"advert\":null,\"item\":{\"goods\":{\"goodsId\":\"600014752662\",\"title\":\"Комод Моби Остин 16.221 графит/дуб крафт золотой, 120х41,9х99,3 см\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/921/631/049/121/303/1/600014752662b0.jpeg\",\"attributes\":[{\"title\":\"Размеры (ШхГхВ), см\",\"slug\":\"\",\"value\":\"120х41,9х99,3\",\"group\":{\"title\":\"Размеры и вес\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":117760,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/komod-mobi-ostin-16221-grafit-dub-kraft-zolotoy-120h419h993-sm-600014752662/\",\"slug\":\"komod-mobi-ostin-16221-grafit-dub-kraft-zolotoy-120h419h993-sm-600014752662\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":40,\"height\":23,\"length\":124,\"weightUnit\":\"кг\",\"weight\":63}],\"categoryId\":\"2463684633919108\",\"brand\":\"mobi\",\"contentFlags\":[],\"contentFlagsStr\":[],\"stocks\":1,\"photosCount\":11,\"offersCount\":1,\"logisticTags\":[],\"images\":[\"https://main-cdn.sbermegamarket.ru/big2/hlr-system/921/631/049/121/303/1/600014752662b0.jpeg\",\"https://main-cdn.sbermegamarket.ru/big2/hlr-system/921/631/050/121/303/1/600014752662b1.jpeg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/921/631/051/121/303/1/600014752662b2.jpeg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/921/631/052/121/303/1/600014752662b3.jpeg\"],\"documents\":[],\"description\":\"Комод Остин 16.221.\\u003c/br\\u003e  Комод имеет три части - центральная - это 4 выдвижных ящика, по бокам расположены закрытые распашными дверками ниши с двумя полками в каждой. В комоде предусмотрены съемные полки. Скрытые направляющие выдвижных ящиков предназначены для обеспечения мягкого и плавного закрывания. Эти направляющие интегрированы таким образом, что они незаметны с внешней стороны, обеспечивая эстетичный внешний вид и комфортное использование мебели. Двери оснащены 4хшарнирными петлями без доводчиков, что обеспечивает простоту использования. Мебель оснащена регулируемыми опорами, выполненными из серого пластика. Лицевая фурнитура в виде черных аккуратных ручек. Изготовлена мебель из популярного материала - ламинированной ДСП 16 мм, торцы окромлены ПХВ плёнкой. Фасады выполнены из рамочного профиля из МДФ со вставками ДВПО с узором. Поставляется в разобранном виде, с комплектом фурнитуры, упакованная в 4-х слойный гофрокартон.\\u003c/br\\u003e  Габариты (ШхГхВ): комода - 120х41,9х99,3 см.\",\"videos\":[],\"mainCollectionId\":\"686932\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":22714,\"priceFrom\":22714,\"priceTo\":0,\"bonusPercent\":15,\"bonusAmount\":2897,\"rating\":4.7,\"reviewCount\":3,\"offerCount\":1,\"finalPrice\":19307,\"favoriteOffer\":{\"id\":\"0\",\"price\":22714,\"score\":0,\"isFavorite\":true,\"merchantId\":\"12824\",\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"finalPrice\":19307,\"bonusPercent\":15,\"bonusAmount\":2897,\"availableQuantity\":0,\"bonusAmountFinalPrice\":0,\"discounts\":[],\"priceAdjustments\":[],\"deliveryDate\":\"\",\"pickupDate\":\"\",\"merchantOfferId\":\"\",\"merchantName\":\"Мебель 24 DBS\",\"merchantLogoUrl\":\"\",\"merchantUrl\":\"/shop/mebel-24-dbs/\",\"merchantSummaryRating\":0,\"isBpgByMerchant\":false,\"nds\":0,\"oldPrice\":22714,\"oldPriceChangePercentage\":-15,\"maxDeliveryDays\":null,\"bpgType\":\"UNKNOWN_BPG_TYPE\",\"creditPaymentAmount\":0,\"installmentPaymentAmount\":0,\"showMerchant\":null,\"salesBlockInfo\":null,\"dueDate\":\"DEFAULT_DELIVERY_OFFER_DUE_DATE\",\"d