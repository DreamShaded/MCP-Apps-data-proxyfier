ence\":230,\"featureDescription\":\"\"},{\"title\":\"Материал каркаса\",\"slug\":\"\",\"value\":\"лдсп\",\"group\":{\"title\":\"Материалы и цвет\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":390,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/polka-nastennaya-mobi-ostin-16484-belyy-dub-kraft-zolotoy-120h20h216-sm-600014752372/\",\"slug\":\"polka-nastennaya-mobi-ostin-16484-belyy-dub-kraft-zolotoy-120h20h216-sm-600014752372\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":20,\"height\":3,\"length\":130,\"weightUnit\":\"кг\",\"weight\":5}],\"categoryId\":\"2463684633919108\",\"brand\":\"mobi\",\"contentFlags\":[],\"contentFlagsStr\":[],\"stocks\":1,\"photosCount\":6,\"offersCount\":1,\"logisticTags\":[],\"images\":[\"https://main-cdn.sbermegamarket.ru/big1/hlr-system/918/890/277/121/260/600014752372b0.jpeg\",\"https://main-cdn.sbermegamarket.ru/big1/hlr-system/918/890/278/121/260/600014752372b1.jpeg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/918/890/279/121/260/600014752372b2.jpeg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/918/890/280/121/260/600014752372b3.jpeg\"],\"documents\":[],\"description\":\"\\u003cp\\u003e\\u003cstrong\\u003eПолка настенная Остин 16.484.\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cp\\u003eКлассическая настенная открытая полка с задней панелью. Полка располагается по центру панели. Полку настенную Остин 16.484 можно использовать как книжную, а также для размещения элементов декора, поделок и фоторгафий. Полка имеет с обратной стороны панели скрытые крепленния. Максимальная нагрузка на полку составляет 5 кг. Полка изготовлена из экологически чистой ламинированной ДСП 16 мм, торцы окромлены ПХВ плёнкой. Поставляется в разобранном виде, с комплектом фурнитуры, упакованная в 4-х слойный гофрокартон.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eГабаритные размеры полки (ШхГхВ): \\u003c/strong\\u003e120х20х21,6 см.\\u003c/p\\u003e\",\"videos\":[],\"m