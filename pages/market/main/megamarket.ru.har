901903\",\"2520046\",\"2521971\",\"2521972\",\"2521973\",\"2521974\",\"6779430\",\"7491883\",\"689626\",\"689915\",\"701511\",\"768079\",\"1758082\",\"1913425\",\"2608710\",\"6814218\",\"7324325\",\"7324868\",\"7497944\",\"4007638\",\"4335165\",\"9564170\",\"9816826\",\"10065609\",\"10079911\",\"10084997\",\"10084998\",\"10084999\",\"10085022\",\"10085030\"],\"hasOtherOffers\":false,\"ranking\":{\"value\":\"\",\"valueBi\":\"\"},\"auctionInfo\":{\"analytics\":{\"adCode\":\"\",\"adName\":\"\",\"campaignCode\":\"\",\"campaignName\":\"\",\"advertiserId\":0,\"advertiserName\":\"\",\"channels\":[],\"placeName\":[],\"amazMeReference\":\"\",\"adMark\":\"\",\"campaignType\":\"\"},\"ord\":{\"showBadge\":false,\"organizationName\":\"\",\"creativeMarker\":\"\"}},\"goodsIdAlt\":\"600020560377_12824\",\"bonusAmountFinalPriceToStr\":\"1 946\"},\"visualType\":\"B\",\"side\":\"RIGHT\"},{\"type\":\"ITEM\",\"advert\":null,\"item\":{\"goods\":{\"goodsId\":\"600005384109\",\"title\":\"Комплект для уборки Profi Compact: ведро с прессом для отжима и швабра\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/-65/060/423/241/819/17/600005384109b0.jpg\",\"attributes\":[{\"title\":\"Материал\",\"slug\":\"\",\"value\":\"металл; пластик; микрофибра\",\"group\":{\"title\":\"Материалы и цвет\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":114688,\"featureDescription\":\"\"},{\"title\":\"Отжим\",\"slug\":\"\",\"value\":\"Да\",\"group\":{\"title\":\"Особенности\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":117760,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/komplekt-dlya-uborki-profi-compact-vedro-s-pressom-dlya-otzhima-i-shvabra-600005384109/\",\"slug\":\"komplekt-dlya-uborki-profi-compact-vedro-s-pressom-dlya-otzhima-i-shvabra-600005384109\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":39,\"height\":50,\"length\":28,\"weightUnit\":\"кг\",\"weight\":2}],\"categoryId\":\"80203\",\"brand\":\"Leifheit\",\"contentFlags\":[],\"contentFlagsStr\":[],\"stocks\":1,\"photosCount\":10,\"offersCount\":3,\"logisticTags\":[\"MGT\"],\"images\":[\"https://main-cdn.sbermegamarket.ru/big1/hlr-system/-65/060/423/241/819/17/600005384109b0.jpg\",\"https://main-cdn.sbermegamarket.ru/big1/hlr-system/-65/060/423/141/819/17/600005384109b1.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/-65/060/423/041/819/17/600005384109b2.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/-65/060/422/941/819/17/600005384109b3.jpg\"],\"documents\":[],\"description\":\"Требуется совсем немного усилий для отжимания швабры, никаких раздражающих сгибаний, наклонов и никакого контакта с грязной водой - тот кто приобретает систему Profi от Leifheit, получает максимальный комфорт во время уборки. Набор состоит из ведра с прессом для тряпки Profi Compact и швабры для мытья пола Profi XL micro duo с 3-секционной разборной ручкой. Благодаря ведру с прессом, насадку можно легко отжать. Лишняя вода отжимается из насадки путем нажатия рукояткой швабры на пресс. Нет необходимости нагибаться или допускать контакт рук с грязной водой. Кроме того, для этих действий практически не требуется приложения силы. Для легкой уборки в труднодоступных местах, швабра оснащена шарниром, который можно наклонить под плоским углом. Шарнирное соединение 360° также позволяет производить протирку змеевидной линией. Пресс-насадка для ведра является съемной и имеет прочную ручку для переноски. Ширина насадки 42 см Насадка micro duo состоит на 75% из полиэстера и 25% полиамида\",\"videos\":[],\"mainCollectionId\":\"632427\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":11099,\"priceFrom\":11099,\"priceTo\":0,\"bonusPercent\":15,\"bonusAmount\":1665,\"rating\":5,\"reviewCount\":4,\"offerCount\":3,\"finalPrice\":11099,\"favoriteOffer\":{\"id\":\"0\",\"price\":11099,\"score\":0,\"isFavorite\":true,\"merchantId\":\"15389\",\"deliveryP