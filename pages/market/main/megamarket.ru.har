adCode\":\"\",\"adName\":\"\",\"campaignCode\":\"\",\"campaignName\":\"\",\"advertiserId\":0,\"advertiserName\":\"\",\"channels\":[],\"placeName\":[],\"amazMeReference\":\"\",\"adMark\":\"\",\"campaignType\":\"\"},\"ord\":{\"showBadge\":false,\"organizationName\":\"\",\"creativeMarker\":\"\"}},\"goodsIdAlt\":\"600003116946_12824\",\"bonusAmountFinalPriceToStr\":\"1 800\"},\"visualType\":\"B\",\"side\":\"RIGHT\"},{\"type\":\"ITEM\",\"advert\":null,\"item\":{\"goods\":{\"goodsId\":\"700000173818\",\"title\":\"Кофе в зернах 1 кг DE JANEIRO ESPRESSO ETHIOPIA Арабика 100% Эфиопия\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/ccs/256821/NTUwMl8zODA0MzgwNA==/b0.jpg\",\"attributes\":[{\"title\":\"Вид кофе\",\"slug\":\"\",\"value\":\"в зернах\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":20,\"featureDescription\":\"\"},{\"title\":\"Вес, в граммах\",\"slug\":\"\",\"value\":\"1000\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":30,\"featureDescription\":\"\"},{\"title\":\"Сорт кофе\",\"slug\":\"\",\"value\":\"арабика\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":false,\"isWebListing\":true,\"sequence\":55,\"featureDescription\":\"\"},{\"title\":\"Без кофеина\",\"slug\":\"\",\"value\":\"Нет\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":false,\"isWebListing\":true,\"sequence\":245,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/kofe-v-zernah-de-janeiro-espresso-ethiopia-100-arabika-efiopiya-dlya-kofemashiny-1-kg-700000173818/\",\"slug\":\"kofe-v-zernah-de-janeiro-espresso-ethiopia-100-arabika-efiopiya-dlya-kofemashiny-1-kg-700000173818\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":15,\"height\":25,\"length\":10,\"weightUnit\":\"кг\",\"weight\":1.0499999523162842}],\"categoryId\":\"2463684633782068\",\"brand\":\"DE JANEIRO\",\"contentFlags\":[\"no_credit\",\"no_bnpl\"],\"contentFlagsStr\":[\"no_credit\",\"matrix_smkt\",\"no_bnpl\"],\"stocks\":1,\"photosCount\":6,\"offersCount\":1,\"logisticTags\":[],\"images\":[\"https://main-cdn.sbermegamarket.ru/big1/hlr-system/ccs/256821/NTUwMl8zODA0MzgwNA==/b0.jpg\",\"https://main-cdn.sbermegamarket.ru/big1/hlr-system/ccs/256821/NTUwMl8zODAzODQxNA==/b1.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/ccs/256821/NTUwMl8zODA0MDQ5Ng==/b2.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/ccs/256821/NTUwMl8zODA0MTI4OA==/b3.jpg\"],\"documents\":[],\"description\":\"\\u003cp\\u003eБРЕНД DE JANEIRO (ДЕ ЖАНЕЙРО) НАСТОЯЩИЙ КОФЕ ИЗ БРАЗИЛИИ В ЗЁРНАХ.\\u003c/p\\u003e\\u003cp\\u003eКофе в зёрнах DE JANEIRO ESPRESSO ETHIOPIA (ЭФИОПИЯ).\\u003c/p\\u003e\\u003cp\\u003eСостав: великолепный дуэт отборной 100% арабики из Эфиопии и Бразилии. Средняя обжарка.\\u003c/p\\u003e\\u003cp\\u003eИменно в Эфиопии, на родине кофейного дерева, растут сорта, равных которым нет во всем мире. Арабика из Эфиопии добавляет в бленд яркость вкуса и фруктовую сладость, а бразильская аромат и бодрящий эффект. Такое сочетание никого не оставит равнодушным.\\u003c/p\\u003e\\u003cp\\u003eБразильский кофе DE JANEIRO создаёт особую атмосферу. Наш зерновой кофе идеален для приготовления в турке или джезве, френч-прессе, гейзерной, рожковой, капельной кофеварке или кофемашине. Также его можно заваривать в чашке.\\u003c/p\\u003e\\u003cp\\u003eЧтобы Вы смогли почувствовать все оттенки насыщенного вкуса, мы используем специальную упаковку с замком Zip-Lock (Зип Лок) и клапаном дегазации, которые надолго сохранят преимущества свежеобжаренного кофе. А для максимальной защиты в процессе транспортировки мы упаковываем кофе в дополнительную плёнку.\\u003c/p\\u003e\",\"videos\":[],\"mainCollectionId\":\"272416\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":2150,\"priceFrom\":2150,\"p