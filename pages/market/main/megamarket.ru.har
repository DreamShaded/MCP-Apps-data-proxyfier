":\"600005384109_15389\",\"bonusAmountFinalPriceToStr\":\"до 1 665\"},\"visualType\":\"A\",\"side\":\"LEFT\"},{\"type\":\"ITEM\",\"advert\":null,\"item\":{\"goods\":{\"goodsId\":\"700000173850\",\"title\":\"Кофе в зернах 1 кг DE JANEIRO ESPRESSO SUPERIOR Арабика 100% Бразилия Моджиана\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/ccs/256821/MTMzN181Nzk5NTczOTg=/b0.jpg\",\"attributes\":[{\"title\":\"Вид кофе\",\"slug\":\"\",\"value\":\"в зернах\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":20,\"featureDescription\":\"\"},{\"title\":\"Вес, в граммах\",\"slug\":\"\",\"value\":\"1000\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":30,\"featureDescription\":\"\"},{\"title\":\"Сорт кофе\",\"slug\":\"\",\"value\":\"арабика\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":false,\"isWebListing\":true,\"sequence\":55,\"featureDescription\":\"\"},{\"title\":\"Без кофеина\",\"slug\":\"\",\"value\":\"Нет\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":false,\"isWebListing\":true,\"sequence\":245,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/kofe-v-zernah-de-janeiro-espresso-superior-100-arabika-braziliya-modzhiana-1-kg-700000173850/\",\"slug\":\"kofe-v-zernah-de-janeiro-espresso-superior-100-arabika-braziliya-modzhiana-1-kg-700000173850\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":15,\"height\":25,\"length\":10,\"weightUnit\":\"кг\",\"weight\":1}],\"categoryId\":\"2463684633782068\",\"brand\":\"DE JANEIRO\",\"contentFlags\":[\"no_credit\",\"no_bnpl\"],\"contentFlagsStr\":[\"no_credit\",\"matrix_smkt\",\"no_bnpl\"],\"stocks\":1,\"photosCount\":6,\"offersCount\":1,\"logisticTags\":[],\"images\":[\"https://main-cdn.sbermegamarket.ru/big1/hlr-system/ccs/256821/MTMzN181Nzk5NTczOTg=/b0.jpg\",\"https://main-cdn.sbermegamarket.ru/big1/hlr-system/ccs/256821/MTMzN181Nzk5NTIwNTg=/b1.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/ccs/256821/MTMzN181Nzk5NTQzNDI=/b2.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/ccs/256821/MTMzN181Nzk5NTUyODc=/b3.jpg\"],\"documents\":[],\"description\":\"\\u003cp\\u003eБРЕНД DE JANEIRO (ДЕ ЖАНЕЙРО) НАСТОЯЩИЙ КОФЕ ИЗ БРАЗИЛИИ В ЗЁРНАХ.\\u003c/p\\u003e\\u003cp\\u003eКофе в зёрнах DE JANEIRO ESPRESSO SUPERIOR. Можиана 100% арабика. Регион Можиана (Моджиана) один из крупнейших производителей кофе в Бразилии. Кофе из этого региона традиционно отличается сбалансированным вкусом, приятным ароматом и густой пенкой. Идеален для заряда бодрости на весь день. Придётся по вкусу любителям настоящего бразильского кофе.\\u003c/p\\u003e\\u003cp\\u003eНаш зерновой кофе идеален для эспрессо, американо, ристретто, кофе по-турецки. Подходит для приготовления в турке или джезве, френч-прессе, гейзерной, рожковой, капельной кофеварке или кофемашине. Также его можно заваривать в чашке. Можно готовить напитки с добавлением молока - латте, каппучино, сливок - раф, или специй по вашему вкусу.\\u003c/p\\u003e\\u003cp\\u003eДля того чтобы максимально сохранить вкус и аромат свежеобжаренного кофе, мы применяем в производстве более дорогую упаковку с замком Zip-Lock (многократное открытие и закрытие для увеличения срока хранения). Его нужно открыть, потянув за специальный ключик-замок, который находится на лицевой стороне над воздушным клапаном. А для максимальной защиты в процессе транспортировки мы упаковываем кофе в дополнительную плёнку толщиной 100 микрон. Наше производство сертифицировано по мировому стандарту ХАССП и работает под контролем дипломированных специалистов.\\u003c/p\\u003e\\u003cp\\u003eС уважением, команда DE JANEIRO\\u003c/p\\u003e\",\"videos\":[],\"mainCollectionId\":\"272416\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":2500,\"priceFrom\":2500,\"p