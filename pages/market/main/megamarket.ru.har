eryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"finalPrice\":46,\"bonusPercent\":0,\"bonusAmount\":0,\"availableQuantity\":0,\"bonusAmountFinalPrice\":0,\"discounts\":[],\"priceAdjustments\":[],\"deliveryDate\":\"\",\"pickupDate\":\"\",\"merchantOfferId\":\"\",\"merchantName\":\"АШАН - Купер\",\"merchantLogoUrl\":\"https://min-lb-vip.goods.ru/mms/img/1775659719890-e3efc131-40ae-4acd-b39a-5cb04a6a1cf4\",\"merchantUrl\":\"/shop/ashan-kuper/\",\"merchantSummaryRating\":0,\"isBpgByMerchant\":false,\"nds\":0,\"oldPrice\":0,\"oldPriceChangePercentage\":0,\"maxDeliveryDays\":null,\"bpgType\":\"UNKNOWN_BPG_TYPE\",\"creditPaymentAmount\":0,\"installmentPaymentAmount\":0,\"showMerchant\":null,\"salesBlockInfo\":null,\"dueDate\":\"EXPRESS_OFFER_DUE_DATE\",\"dueDateText\":\"\",\"locationId\":\"270634\",\"spasiboIsAvailable\":false,\"isShowcase\":false,\"loyaltyPromotionFlags\":[],\"pricesPerMeasurement\":[],\"availablePaymentMethods\":[],\"superPrice\":0,\"warehouseId\":\"270634\",\"bnplPaymentParams\":null,\"installmentPaymentParams\":null,\"bonusInfoGroups\":[],\"calculatedDeliveryDate\":\"От 2 часов\",\"goodsId\":\"\",\"typeFilters\":[],\"goodsSlug\":\"\",\"fastPurchaseOptions\":null,\"bonusAmountFinalPriceToStr\":\"\",\"tags\":[],\"goodsIdAlt\":\"\"},\"relatedItems\":[],\"productSelectors\":[],\"extraOptions\":[],\"deliveryPossibilities\":[{\"code\":\"CND\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":false,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставка за 2-3 часа\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"discounts\":[],\"contentFlagsStr\":[\"no_credit\",\"no_bnpl\"],\"contentFlags\":[\"no_credit\",\"no_bnpl\"],\"badges\":[],\"crossedPrice\":0,\"crossedPricePeriod\":\"\",\"lastPrice\":25,\"isAvailable\":true,\"crossedPriceChangePercentage\":0,\"collections\":[\"10107\",\"11178\",\"477785\",\"477795\",\"477975\",\"477976\",\"12782\",\"15588\",\"496381\",\"496386\",\"496866\",\"2043747\",\"6150141\",\"1230049\",\"2322916\",\"2323035\",\"2323068\",\"2323414\",\"6646499\",\"4008977\",\"4328383\",\"4328738\",\"4335947\",\"4339262\",\"4339596\",\"4765906\",\"5893525\",\"5923243\",\"6738015\",\"7286231\",\"7394684\",\"7394742\",\"8254229\",\"10051593\"],\"hasOtherOffers\":false,\"ranking\":{\"value\":\"\",\"valueBi\":\"\"},\"auctionInfo\":{\"analytics\":{\"adCode\":\"\",\"adName\":\"\",\"campaignCode\":\"\",\"campaignName\":\"\",\"advertiserId\":0,\"advertiserName\":\"\",\"channels\":[],\"placeName\":[],\"amazMeReference\":\"\",\"adMark\":\"\",\"campaignType\":\"\"},\"ord\":{\"showBadge\":false,\"organizationName\":\"\",\"creativeMarker\":\"\"}},\"goodsIdAlt\":\"100028050953_14728\",\"bonusAmountFinalPriceToStr\":\"\"},\"visualType\":\"A\",\"side\":\"LEFT\"},{\"type\":\"ADVERT\",\"advert\":{\"type\":\"GBL\",\"identificationCode\":\"000338187\",\"placeId\":\"100111341\",\"caption\":\"\",\"items\":[{\"goods\":{\"goodsId\":\"700006144102_263509\",\"title\":\"Терморегулятор для теплого пола с Wi-Fi электронный Теплолюкс Solus Air белый/золото\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/ccs/263509/MTAwMDAwMzgwMTAwXzQ4ODI5Mzg4NA==/b0.webp\",\"attributes\":[{\"title\":\"Вид управления\",\"slug\":\"\",\"value\":\"сенсорное\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":103424,\"featureDescription\":\"\"},{\"title\":\"Количество режимов нагрева\",\"slug\":\"\",\"value\":\"5\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":104448,\"featureDescription\":\"\"},{\"title\":\"Мощность, кВт\",\"slug\":\"\",\"value\":\"3.5\",\"group\":{\"title\":\"Заводские данные о товаре\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":111616,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/termoregulyator-dlya-teplogo-pola-s-wi-fi-elektronnyy-teplolyuks-solus-air-belyy-zoloto-700006144102/\",\"slug\":\"termoregulyator-dlya-teplogo-pola-s-wi-fi-elektronnyy-teplolyuks-solus-air-belyy-zoloto-700006144102_263509\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":6,\"height\":10.5,\"length\":10.199999809265137,\"weightUnit\":\"кг\",\"weight\":0.25999999046325684}],\"categoryId\":\"4\",\"brand\":\"Теплолюкс\",\"contentFlags\":[],\"contentFlagsStr\":[],\"stocks\":1,\"photosCount\":11,\"offersCount\":1,\"logisticTags\":[],\"images\":[\"https://main-cdn.sbermegamarket.ru/big1/hlr-system/ccs/263509/MTAwMDAwMzgwMTAwXzQ4ODI5Mzg4NA==/b0.webp\",\"https://main-cdn.sbermegamarket.ru/big1/hlr-system/ccs/263509/MTAwMDAwMzgwMTAwXzQ4ODI4Mjc4Ng==/b1.webp\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/ccs/263509/MTAwMDAwMzgwMTAwXzQ4ODI4NDcyNw==/b2.webp\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/ccs/263509/MTAwMDAwMzgwMTAwXzQ4ODI4NTc2Mw==/b3.webp\"],\"documents\":[],\"description\":\"Терморегулятор Теплолюкс Solus Air предназначен для управления системой теплый пол, поддержания комфортной температуры обогреваемой поверхности. Управление осуществляется по двум датчикам - температуры пола и воздуха. Модель оснащена модулями Wi-Fi и Bluetooth для работы через приложение SmartLife с возможностью синхронизации с аккаунтом умного дома Яндекс Алиса. Умный дисплей со встроенным датчиком движения гаснет в режиме ожидания и автоматически включается при приближении на расстояние 0,3 метра, что не мешает сну и экономит энергию. Тонкая рамка толщиной 5,5 мм создаёт парящий эффект и подчёркивает элегантный профиль при монтаже на стену. Минималистичный дизайн лишён лишних элементов индикации, а цветовую подсветку дисплея можно настроить по своему вкусу. Матовый корпус не собирает отпечатки пальцев. Встроенный датчик температуры воздуха позволяет выбирать приоритет регулирования - по полу или по воздуху в помещении. Быстрозажимные клеммы упрощают подключение и ускоряют монтаж на 25%. Функция «Режим открытого окна» отключает обогрев при обнаружении резкого падения температуры на 2°C в течение 15 минут для экономии электроэнергии. Защита от замерзания автоматически активирует нагрев при охлаждении до +5°C. Специальный режим для кварцвинила прекращает нагрев при достижении полом температуры +28°C, защищая напольное покрытие от перегрева. Также предусмотрена блокировка экрана от случайных нажатий. Через смартфон можно отслеживать статистику электропотребления. Терморегулятор совместим с системами водяного тёплого пола при использовании нормально закрытой термоголовки на 230 В.\",\"videos\":[],\"mainCollectionId\":\"15223\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":6350,\"priceFrom\":6350,\"priceTo\":0,\"bonusPercent\":35,\"bonusAmount\":2223,\"rating\":0,\"reviewCount\":0,\"offerCount\":1,\"finalPrice\":6350,\"favoriteOffer\":{\"id\":\"0\",\"price\":6350,\"score\":0,\"isFavorite\":true,\"merchantId\":\"263509\",\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"finalPrice\":6350,\"bonusPercent\":35,\"bonusAmount\":2223,\"availableQuantity\":0,\"bonusAmountFinalPrice\":0,\"discounts\":[],\"priceAdjustments\":[],\"deliveryDate\":\"\",\"pickupDate\":\"\",\"merchantOfferId\":\"\",\"merchantName\":\"ООО Группа Теплолюкс DBS\",\"merchantLogoUrl\":\"\",\"merchantUrl\":\"/shop/ooo-gruppa-teplolyuks-dbs/\",\"merchantSummaryRating\":0,\"isBpgByMerchant\":false,\"nds\":0,\"oldPrice\":0,\"oldPriceChangePercentage\":0,\"maxDeliveryDays\":null,\"bpgType\":\"UNKNOWN_BPG_TYPE\",\"creditPaymentAmount\":0