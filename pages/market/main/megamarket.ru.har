ies\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"discounts\":[],\"contentFlagsStr\":[],\"contentFlags\":[],\"badges\":[],\"crossedPrice\":0,\"crossedPricePeriod\":\"\",\"lastPrice\":1827,\"isAvailable\":true,\"crossedPriceChangePercentage\":0,\"collections\":[\"834576\",\"834639\",\"4355185\",\"4374072\",\"4437492\",\"4437493\",\"12782\",\"686880\",\"686930\",\"2016651\",\"3375139\",\"4788123\",\"4788139\",\"6779418\",\"6779419\",\"7171276\",\"2162469\",\"9345316\",\"689626\",\"1447215\",\"2016958\",\"3375153\",\"4788397\",\"4789975\",\"6811557\",\"6831679\",\"7214391\",\"4007638\",\"4335165\",\"9816826\",\"10079911\",\"10084997\",\"10084998\",\"10084999\",\"10085022\",\"10085030\"],\"hasOtherOffers\":false,\"ranking\":{\"value\":\"\",\"valueBi\":\"\"},\"auctionInfo\":{\"analytics\":{\"adCode\":\"\",\"adName\":\"\",\"campaignCode\":\"\",\"campaignName\":\"\",\"advertiserId\":0,\"advertiserName\":\"\",\"channels\":[],\"placeName\":[],\"amazMeReference\":\"\",\"adMark\":\"\",\"campaignType\":\"\"},\"ord\":{\"showBadge\":false,\"organizationName\":\"\",\"creativeMarker\":\"\"}},\"goodsIdAlt\":\"600014752372_12824\",\"bonusAmountFinalPriceToStr\":\"270\"},\"visualType\":\"B\",\"side\":\"RIGHT\"},{\"type\":\"ITEM\",\"advert\":null,\"item\":{\"goods\":{\"goodsId\":\"600020560377\",\"title\":\"Стол компьютерный Mobi Комфорт 12.71 гикори/дымчатый зелёный, 116,7х60х165,4 см\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/100/185/684/282/591/5/600020560377b0.jpg\",\"attributes\":[{\"title\":\"Материал столешницы\",\"slug\":\"\",\"value\":\"лдсп\",\"group\":{\"title\":\"Материалы и цвет\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":135168,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/stol-kompyuternyy-mobi-komfort-1271-gikori-dymchatyy-zelenyy-1167h60h1654-sm-600020560377/\",\"slug\":\"stol-kompyuternyy-mobi-komfort-1271-gikori-dymchatyy-zelenyy-1167h60h1654-sm-600020560377\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":60,\"height\":16,\"length\":105,\"weightUnit\":\"кг\",\"weight\":62}],\"categoryId\":\"2463684633919143\",\"brand\":\"mobi\",\"contentFlags\":[],\"contentFlagsStr\":[],\"stocks\":1,\"photosCount\":15,\"offersCount\":1,\"logisticTags\":[],\"images\":[\"https://main-cdn.sbermegamarket.ru/big1/hlr-system/100/185/684/282/591/5/600020560377b0.jpg\",\"https://main-cdn.sbermegamarket.ru/big1/hlr-system/100/185/684/382/591/5/600020560377b1.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/100/185/684/482/591/5/600020560377b2.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/100/185/684/582/591/5/600020560377b3.jpg\"],\"documents\":[],\"description\":\"\\u003cp\\u003e\\u003cstrong\\u003eСтол компьютерный Комфорт 12.71\\u003c/strong\\u003e - удачное сочетание комфорта и делового стиля.\\u003c/p\\u003e\\u003cp\\u003eКлассический, удобный, устойчивый стол с тумбой под системный блок и выдвижным ящиком для канцелярии, дополнен практичной надстройкой. Надстройка с вместительной нишей за откидным фасадом и распашным отделением с полкой, выделяет на столе удобную нишу для монитора. По центру задней стороны столешницы расположен кабель-канал, который позволяет аккуратно и незаметно провести провода, поддерживая порядок на рабочем месте. Закрытые отделения стола компьютерного Комфорт 12.71 хранят деловые тайны, а пять полок стеллажа - документы, книги в удобной близости. Тумба расположена с правой стороны стола компьютерного, стеллаж - с левой - универсальная сборка не предусмотрена.\\u003c/p\\u003e\\u003cp\\u003eЯщик на шариковых направляющих полного выдвижения, который обеспечивает надёжное прямолинейное перемещение. Подъемный фасад и ящик стола Комфорт 12.71 открываются за край фасада. Распашные фасады надстройки и тумбы открываются нажатием. Распашные двери мебели на четырёхшарнирных петлях без доводчиков, откидные фасады - на газовых лифтах. Дно ящиков и задние стенки врезные, выполненные из облагороженного ХДФ, позволяющего ящикам выдерживать большую нагрузку.\\u003c/p\\u003e\\u003cp\\u003eСтол компьютерный изготовлен из высококачественной ламинированной ДСП, толщиной 16 мм. Торцы деталей облицованы кромкой ПВХ 2 мм. и ПВХ 0,4 мм., что улучшает эстетический вид и продлевает срок службы мебели. Высокая точность соблюдения технологических размеров и сверления отверстий обеспечивает быструю и лёгкую сборку мебели. В производстве использована современная фурнитура, отличающаяся высокой надёжностью и долговечностью. Мебель Комфорт поставляется в разобранном виде, упакованная в 4-х слойный гофрокартон, с инструкцией по сборке и фурнитурой.\\u003c/br\\u003eВыполнено в цвете: гикори рокфорд натуральный/дымчатый зелёный.\\u003c/br\\u003eГабариты стола компьютерного (ШхГхВ): 117.7х60,2х165,4 см.\\u003c/br\\u003eНиша для монитора (ШхГхВ): 95х59х30 см.\\u003c/br\\u003eИсполнение стола: не универсальная сборка, кабель канал, с тумбой под системный блок.\\u003c/p\\u003e\",\"videos\":[],\"mainCollectionId\":\"2520046\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":15258,\"priceFrom\":15258,\"priceTo\":0,\"bonusPercent\":15,\"bonusAmount\":1946,\"rating\":3,\"reviewCount\":1,\"offerCount\":1,\"finalPrice\":12969,\"favoriteOffer\":{\"id\":\"0\",\"price\":15258,\"score\":0,\"isFavorite\":true,\"merchantId\":\"12824\",\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"delivery