64335\",\"4342099\",\"8813469\",\"10085000\",\"10085010\",\"10085034\"],\"hasOtherOffers\":false,\"ranking\":{\"value\":\"\",\"valueBi\":\"\"},\"auctionInfo\":{\"analytics\":{\"adCode\":\"\",\"adName\":\"\",\"campaignCode\":\"\",\"campaignName\":\"\",\"advertiserId\":0,\"advertiserName\":\"\",\"channels\":[],\"placeName\":[],\"amazMeReference\":\"\",\"adMark\":\"\",\"campaignType\":\"\"},\"ord\":{\"showBadge\":false,\"organizationName\":\"\",\"creativeMarker\":\"\"}},\"goodsIdAlt\":\"100029734671_141409\",\"bonusAmountFinalPriceToStr\":\"\"},\"visualType\":\"B\",\"side\":\"RIGHT\"},{\"type\":\"ADVERT\",\"advert\":{\"type\":\"GBL\",\"identificationCode\":\"000338179\",\"placeId\":\"100111339\",\"caption\":\"\",\"items\":[{\"goods\":{\"goodsId\":\"600010003309_105316\",\"title\":\"Матрас IKEA/ИКЕА Ховаг Экстра Фирм, независимые пружины, 160х200 см\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/129/879/312/321/615/600010003309b0.jpg\",\"attributes\":[{\"title\":\"Стороны\",\"slug\":\"\",\"value\":\"односторонний\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":false,\"isWebListing\":true,\"sequence\":108544,\"featureDescription\":\"\"},{\"title\":\"Высота, см\",\"slug\":\"\",\"value\":\"24\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":114688,\"featureDescription\":\"\"},{\"title\":\"Тип наполнителя\",\"slug\":\"\",\"value\":\"комбинированный\",\"group\":{\"title\":\"Материалы, цвет и вес\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":129024,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/matras-hilding-ikea-hovag-nezavisimye-pruzhiny-160h200-sm-600010003309/\",\"slug\":\"matras-hilding-ikea-hovag-nezavisimye-pruzhiny-160h200-sm-600010003309_105316\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":40,\"height\":24,\"length\":166,\"weightUnit\":\"кг\",\"weight\":35}],\"categoryId\":\"804010501\",\"brand\":\"IKEA\",\"contentFlags\":[],\"contentFlagsStr\":[],\"stocks\":1,\"photosCount\":14,\"offersCount\":1,\"logisticTags\":[\"KGT\"],\"images\":[\"https://main-cdn.sbermegamarket.ru/big1/hlr-system/129/879/312/321/615/600010003309b0.jpg\",\"https://main-cdn.sbermegamarket.ru/big1/hlr-system/129/879/313/321/615/600010003309b1.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/129/879/314/321/615/600010003309b2.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/129/879/315/321/615/600010003309b3.jpg\"],\"documents\":[],\"description\":\"\\u003cp\\u003eМатрас из ассортимента Икеа Ховаг Экстра Фирм еще более жесткий, чем Ховаг Фирм (за счет усиления пружинного блока).\\u003c/p\\u003e\\u003cp\\u003eИзготовлено в России на производственных мощностях для проекта IKEA (Икея), официальным производителем IKEA.\\u003c/p\\u003e\\u003cp\\u003eОдносторонний, очень жесткий, с независимыми пружинами. Пружинный блок Pocket состоит из множества автономных ячеек, пружины идеально подстраивается под изгибы тела, равномерно распределяя нагрузку и обеспечивая точечную поддержку позвоночника (ортопедический эффект).\\u003c/p\\u003e\\u003cp\\u003eАнатомическая пена (пенополиуретан) в составе матраса комфортный барьер между пружинным блоком и спальной поверхностью, позволяет принять удобное положение во время сна. Еще один дополнительный слой хлопковый войлок защищает и амортизирует пружинный блок, а также выполняет роль терморегулятора, давая летом больше прохлады, а зимой тепла.\\u003c/p\\u003e\\u003cp\\u003eВерхний слой матраса придат матрасу дополнительную мягкость: трикотажный чехол, стганный на синтепоне и вязкоэластичной пене. Также из преимуществ - повышенная прочность и износостойкость. Практичные ручки по бокам матрас легко перевернуть. Усиление по периметру пенополиуретановым коробом по краям матраса это дополнительная фиксация и поддержание исходной формы матраса на весь срок эксплуатации.\\u003c/p\\u003e\\u003cp\\u003eПри производстве матраса все материалы проверяются на безопасность и износостойкость. Готовый матрас также прошл физико-механические испытания на долговечность, которые имитируют интенсивное использование.\\u003c/p\\u003e\\u003cp\\u003eДоставляется в компактном скрученном виде (в рулоне). После вскрытия упаковки матрас в скрутке полностью распрямится и восстановит свою форму в соответствии с заявленным размером через 72 часа. Спать на матрасе можно сразу же после распаковки.\\u003c/p\\u003e\",\"videos\":[],\"mainCollectionId\":\"14009\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":52141,\"priceFrom\":52141,\"priceTo\":0,\"bonusPercent\":55,\"bonusAmount\":12650,\"rating\":4.9,\"reviewCount\":470,\"offerCount\":1,\"finalPrice\":23000,\"favoriteOffer\":{\"id\":\"0\",\"price\":52141,\"score\":0,\"isFavorite\":true,\"merchantId\":\"105316\",\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"finalPrice\":23000,\"bonusPercent\":55,\"bonusAmount\":12650,\"availableQuantity\":0,\"bonusAmountFinalPrice\":0,\"discounts\":[],\"priceAdjustments\":[],\"deliveryDate\":\"\",\"pickupDate\":\"\",\"merchantOfferId\":\"\",\"merchantName\":\"buyson.ru Россия\",\"merchantLogoUrl\":\"\",\"merchantUrl\":\"/shop/buysonru-rossiya/\",\"merchantSummaryRating\":0,\"isBpgByMerchant\":false,\"nds\":0,\"oldPrice\":57916,\"oldPriceChangePercentage\":-60,\"maxDeliveryDays\":null,\"bpgType\":\"UNKNOWN_BPG_TYPE\",\"creditPaymentAmount\":0,\"installmentPaymentAmount\":0,\"showMerchant\":null,\"salesBlockInfo\":null,\"dueDate\":\"DEFAULT_DELIVERY_OFFER_DUE_DATE\",\"dueDateText\":\"\",\"locationId\":\"\",\"spasiboIsAvailable\":f