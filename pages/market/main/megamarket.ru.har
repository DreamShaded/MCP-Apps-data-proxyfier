":\"см\",\"width\":0.10000000149011612,\"height\":24,\"length\":29,\"weightUnit\":\"кг\",\"weight\":0.10000000149011612}],\"categoryId\":\"\",\"brand\":\"NoBrand\",\"contentFlags\":[\"service\"],\"contentFlagsStr\":[\"service\"],\"stocks\":1,\"photosCount\":1,\"offersCount\":4,\"logisticTags\":[\"MGT\"],\"images\":[\"https://main-cdn.sbermegamarket.ru/big1/hlr-system/-19/782/783/211/227/100030816052b0.jpg\"],\"documents\":[],\"description\":\"\\u003cp\\u003eПравила заказа услуг по ссылке: https://sbermegamarket.ru/info/pravila-zakaza-uslug\\u003c/p\\u003e\\r\\n\\r\\n\\u003cp\\u003e\\u0026nbsp;\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eВходит в услугу\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u0026nbsp;\\u003c/p\\u003e\\u003cp\\u003e* Выезд специалиста в пределах границы города (для г. Москва выезд в пределах МКАД)\\u003c/p\\u003e\\u003cp\\u003e* Установка угловых кронштейнов на основную стену (без вентфасада и других конструкций)\\u003c/p\\u003e\\u003cp\\u003e* Установка внешнего блока под окном или на балконе (без использования автовышки и работ альпиниста)\\u003c/p\\u003e\\u003cp\\u003e* Сверление одного отверстия диаметром до 45 мм в стене толщиной до 80 см\\u003c/p\\u003e\\u003cp\\u003e* Устройство магистрали открытой прокладки до 2 метров\\u003c/p\\u003e\\u003cp\\u003e* Герметизация отверстия монтажной пеной без отделки\\u003c/p\\u003e\\u003cp\\u003e* Установка внутреннего блока\\u003c/p\\u003e\\u003cp\\u003e* Проверка давления фреона (хладагента)\\u003c/p\\u003e\\u003cp\\u003e* Подключение кондиционера к существующей розетке, настройка его работы, проверка основных режимов работы\\u003c/p\\u003e\\u003cp\\u003e* Очистка рабочей зоны и уборка мусора\\u003c/p\\u003e\\u003cp\\u003e* Демонстрация работы и объяснение основных функций\\u003c/p\\u003e\\u003cp\\u003eРасходные материалы:\\u003c/p\\u003e\\u003cp\\u003e* Кронштейны крепления наружного блока (1 пара)\\u003c/p\\u003e\\u003cp\\u003e* Трубка медная\\u003c/p\\u003e\\u003cp\\u003e* Термоизоляция для трубки медной (2 метра)\\u003c/p\\u003e\\u003cp\\u003e* Кабель электрический ПВС (2 метра)\\u003c/p\\u003e\\u003cp\\u003e* Дренажный шланг диаметром 16 мм (2 метра)\\u003c/p\\u003e\\u003cp\\u003e* Лента изоляционная армированная\\u003c/p\\u003e\\u003cp\\u003e* Дюбель-гвоздь 6х40 (крепление внутреннего блока)\\u003c/p\\u003e\\u003cp\\u003e* Крепеж 10x100 (крепление наружнего блока)\\u003c/p\\u003e\\u003cp\\u003e\\u0026nbsp;\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eНе входит в услугу\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u0026nbsp;\\u003c/p\\u003e\\u003cp\\u003e* Услуги автовышки и работы альпиниста\\u003c/p\\u003e\\u003cp\\u003e* Демонтаж старого кондиционера\\u003c/p\\u003e\\u003cp\\u003e* Межблочная магистраль более 2 метров\\u0026nbsp;\\u003c/p\\u003e\\u003cp\\u003e* Вывод дренажа в канализацию\\u0026nbsp;\\u003c/p\\u003e\\u003cp\\u003e* Доработка розеток и электросети\\u003c/p\\u003e\\u003cp\\u003e* Материалы, не входящие в стандартную установку\\u003c/p\\u003e\\u003cp\\u003e* Выезд за границу города\\u003c/p\\u003e\\u003cp\\u003e* Утилизация упаковки\\u003c/p\\u003e\",\"videos\":[],\"mainCollectionId\":\"0\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":18500,\"priceFrom\":18500,\"priceTo\":0,\"bonusPercent\":0,\"bonusAmount\":0,\"rating\":4.4,\"reviewCount\":78,\"offerCount\":4,\"finalPrice\":18500,\"favoriteOffer\":{\"id\":\"0\",\"price\":18500,\"score\":0,\"isFavorite\":true,\"merchantId\":\"102291\",\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"finalPrice\":18500,\"bonusPercent\":0,\"bonusAmount\":0,\"availableQuantity\":0,\"bonusAmo