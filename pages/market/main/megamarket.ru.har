ossedPricePeriod\":\"\",\"lastPrice\":14230,\"isAvailable\":true,\"crossedPriceChangePercentage\":0,\"collections\":[\"834576\",\"4374112\",\"5000045\",\"5000046\",\"5000047\",\"5000048\",\"12782\",\"13760\",\"14009\",\"458830\",\"458834\",\"686880\",\"686906\",\"1783318\",\"1783319\",\"2474194\",\"2474197\",\"6779418\",\"6882053\",\"8979255\",\"10073363\",\"10073365\",\"10073371\",\"10073382\",\"10073386\",\"10073395\",\"702274\",\"703081\",\"703413\",\"703416\",\"1783499\",\"2396274\",\"2396637\",\"2396685\",\"2476437\",\"2477694\",\"6811708\",\"6906202\",\"8992704\",\"4027117\",\"5115600\",\"8416728\",\"9099066\",\"9816822\",\"9816826\",\"9861444\",\"9861464\",\"9908785\",\"9996749\",\"10005659\",\"10079911\",\"10082534\",\"10084997\",\"10084998\",\"10084999\",\"10086244\",\"10089103\"],\"hasOtherOffers\":false,\"ranking\":{\"value\":\"\",\"valueBi\":\"\"},\"auctionInfo\":{\"analytics\":{\"adCode\":\"\",\"adName\":\"\",\"campaignCode\":\"\",\"campaignName\":\"\",\"advertiserId\":0,\"advertiserName\":\"\",\"channels\":[],\"placeName\":[],\"amazMeReference\":\"\",\"adMark\":\"\",\"campaignType\":\"\"},\"ord\":{\"showBadge\":false,\"organizationName\":\"\",\"creativeMarker\":\"\"}},\"goodsIdAlt\":\"600016119612_34414\",\"bonusAmountFinalPriceToStr\":\"до 4 000\"},\"visualType\":\"B\",\"side\":\"RIGHT\"},{\"type\":\"ITEM\",\"advert\":null,\"item\":{\"goods\":{\"goodsId\":\"700008473846\",\"title\":\"65\\\" Телевизор TCL 65P8L (2026) Premium QLED, 4K Ultra HD, СМАРТ ТВ, Google TV\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/ccs/265274/Mjg4MTZfNDQyNDU2MDMy/b0.png\",\"attributes\":[],\"webUrl\":\"https://megamarket.ru/catalog/details/65-televizor-tcl-65p8l-2026-premium-qled-4k-ultra-hd-smart-tv-google-tv-700008473846/\",\"slug\":\"65-televizor-tcl-65p8l-2026-premium-qled-4k-ultra-hd-smart-tv-google-tv-700008473846\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":100,\"height\":18,\"length\":160,\"weightUnit\":\"кг\",\"weight\":24}],\"categoryId\":\"10201\",\"brand\":\"TCL\",\"contentFlags\":[],\"contentFlagsStr\":[\"recently_published\"],\"stocks\":1,\"photosCount\":16,\"offersCount\":1,\"logisticTags\":[],\"images\":[\"https://main-cdn.sbermegamarket.ru/big1/hlr-system/ccs/265274/Mjg4MTZfNDQyNDU2MDMy/b0.png\",\"https://main-cdn.sbermegamarket.ru/big1/hlr-system/ccs/265274/Mjg4MTZfNDQyMjkyODYx/b1.png\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/ccs/265274/Mjg4MTZfNDQyMjk1NjAy/b2.png\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/ccs/265274/Mjg4MTZfNDQyMjk2NDMx/b3.png\"],\"documents\":[],\"description\":\"TCL 65P8L Premium QLED — большой экран для ярких впечатленийОписаниеПредставьте вечер, когда всё замирает, а на экране оживает целый мир. Телевизор TCL 65P8L Premium QLED с диагональю 65 дюймов создан для тех, кто любит кино, спорт и игры по-настоящему. Он не просто показывает картинку — он дарит ощущение присутствия.Четыре миллиона пикселей в формате 4K Ultra HD раскрывают каждую деталь: от бликов на воде до теней в ночных сценах. Изображение становится объёмным и живым, будто вы смотрите не на экран, а в открытое окно.QLED-технология наполняет кадр чистыми, сочными красками. Каждый оттенок звучит ярко и естественно, а частота обновления 144 Гц превращает даже самые стремительные сцены в плавное течение без рывков и размытий.Технологии HDR10, HDR10+ и Dolby Vision добавляют картинке глубину. Свет становится более искренним, тени — более таинственными. Каждый кадр обретает характер.Звук достоин экрана. Встроенная акустика 2.1 с сабвуфером мощностью 35 Вт наполняет комнату объёмным звучанием. Басы упругие и плотные, диалоги — чёткими и разборчивыми. Вы не просто смотрите фильм — вы живёте внутри него.Смарт-система с голосовым помощником Google Assistant понимает вас с полуслова. Включайте любимые сериалы, ищите музыку, управляйте устройствами — всё это без пульта, просто голосом. AirPlay 2 и Bluetooth 5.4 легко подключают ваши гаджеты, а четыре порта HDMI 2.1 готовы принять игровые консоли и медиаплееры.TCL 65P8L Premium QLED — это не просто телевизор. Это приглашение в мир, где качество имеет значение, а каждый вечер становится событием.\",\"videos\":[],\"mainCollectionId\":\"12203\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":69999,\"priceFrom\":69999,\"priceTo\":0,\"bonusPercent\":0,\"bonusAmount\":0,\"rating\":0,\"reviewCount\":0,\"offerCount\":1,\"finalPrice\":69999,\"favoriteOffer\":{\"id\":\"0\",\"price\":69999,\"score\":0,\"isFavorite\":true,\"merchantId\":\"265274\",\"deliveryPossibilities\":[{\"code\":\"CNC\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":false,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Самовывоз из магазина сегодня\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"finalPrice\":69999,\"bonusPercent\":0,\"bonusAmount\":0,\"availableQuantity\":0,\"bonusAmountFinalPrice\":0,\"discounts\":[],\"priceAdjustments\":[],\"deliveryDate\":\"\",\"pickupDate\":\"\",\"merchantOfferId\":\"\",\"merchantName\":\"Официальный магазин Polaris \",\"merchantLogoUrl\":\"\",\"merchantUrl\":\"\",\"merchantSummaryRating\":0,\"isBpgByMerchant\":false,\"nds\":0,\"oldPrice\":84999,\"oldPriceChangePercentage\":-18,\"maxDeliveryDays\":null,\"bpgType\":\"UNKNOWN_BPG_TYPE\",\"creditPaymentAmount\":0,\"installmentPaymentAmount\":0,\"showMerchant\":null,\"salesBlockInfo\":null,\"dueDate\":\"COLLECT_TODAY_OFFER_DUE_DATE\",\"dueDateText\":\"\",\"locationId\":\"\",\"spasiboIsAvailable\":false,\"isShowcase\":false,\"loyaltyPromotionFlags\":[],\"pricesPerMeasurement\":[],\"availablePaymentMethods\":[],\"superPrice\":0,\"warehouseId\":\"\",\"bnplPaymentParams\":null,\"installmentPaymentParams\":null,\"bonusInfoGroups\":[],\"calculatedDeliveryDate\":\"Сегодня\",\"goodsId\":\"\",\"typeFilters\":[],\"goodsSlug\":\"\",\"fastPurchaseO