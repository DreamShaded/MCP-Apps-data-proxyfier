85\",\"9995292\",\"10007397\",\"10010426\",\"10039699\",\"10066225\",\"10077374\",\"10077375\",\"10077376\",\"10082040\",\"10083114\",\"10084560\",\"10087939\"],\"hasOtherOffers\":false,\"ranking\":null,\"auctionInfo\":null,\"goodsIdAlt\":\"600005444722_99804\",\"bonusAmountFinalPriceToStr\":\"\"},{\"goods\":{\"goodsId\":\"600010980273\",\"title\":\"Проводные наушники Rode Наушники Rode NTH100M Black (НТХ100М)\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/135/375/709/232/016/12/600010980273b0.jpeg\",\"attributes\":[{\"title\":\"Частотный диапазон, в Гц\",\"slug\":\"\",\"value\":\"20-20000\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":111616,\"featureDescription\":\"\"},{\"title\":\"Система активного шумоподавления\",\"slug\":\"\",\"value\":\"Да\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":117760,\"featureDescription\":\"\"},{\"title\":\"Микрофон\",\"slug\":\"\",\"value\":\"Да\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":118784,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/provodnoe-naushniki-rode-naushniki-rode-nth100m-black-nth100m-600010980273/\",\"slug\":\"provodnoe-naushniki-rode-naushniki-rode-nth100m-black-nth100m-600010980273\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":21,\"height\":26,\"length\":12,\"weightUnit\":\"кг\",\"weight\":1}],\"categoryId\":\"2463684633824595\",\"brand\":\"Rode\",\"contentFlags\":[],\"contentFlagsStr\":[],\"stocks\":1,\"photosCount\":3,\"offersCount\":1,\"logisticTags\":[\"MGT\"],\"images\":[\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/135/375/709/232/016/12/600010980273b0.jpeg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/135/375/709/332/016/12/600010980273b1.jpeg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/135/375/709/432/016/12/600010980273b2.jpeg\"],\"documents\":[],\"description\":\"Профессиональные полноразмерные стереонаушники с микрофоном вещательного качества и превосходным качеством мониторинга. Rode NTH-100M идеально подходит для различных нужд производства контента: микширование, производство аудио и видео, запись местоположения, создание подкастов, потоковое вещание и игры. Стереонаушники со съемным микрофоном на штанге обеспечивают вдохновляющее впечатление от прослушивания, сочетая превосходное воспроизведение звука и комфорт со стильным внешним видом.  Функции:  Индивидуальные элементы для наушников 40 мм Накладки на уши и воротник из алькантары Революционные колодки CoolTech Регулируемое оголовье с системой FitLock Кабель, который подключается к обоим наушникам Разработан и изготовлен на заводе Rode в Сиднее. В комплекте: наушники NTH-100M, кабель 2,4 м, переходник для наушников 3,5 мм - 6,3 мм, набор COLORS ID, чехол для переноски Технические характеристики наушников NTH-100:  Частотная характеристика: от 5 до 35 000 Гц Уровень звукового давления: 126 дБ Импеданс: 32 Ом Чувствительность: 110 дБ Характеристики микрофона NTH-MIC:  Шаблон направления: Сфера Частотная характеристика: от 20 до 20 000 Гц Отношение сигнал/шум: 67 дБ SPL: 106 дБ RMS (мощность подключаемого модуля, 1% THD), 123 дБ RMS (мощность подключаемого модуля, 10% THD) Чувствительность: 38 дБ 1 В/Па +/- 3 дБ при 1 кГц\",\"videos\":[],\"mainCollectionId\":\"12392\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":27410,\"priceFrom\":27410,\"priceTo\":0,\"bonusPercent\":0,\"bonusAmount\":0,\"rating\":0,\"reviewCount\":0,\"offerCount\":1,\"finalPrice\":27410,\"favoriteOffer\":{\"id\":\"0\",\"price\":27410,\"score\":0,\"isFavorite\":true,\"merchantId\":\"141924\",\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":tru