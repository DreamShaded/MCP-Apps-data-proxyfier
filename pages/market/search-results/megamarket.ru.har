:\"100069584358_247992\",\"bonusAmountFinalPriceToStr\":\"\"},{\"goods\":{\"goodsId\":\"600023584358_247992\",\"title\":\"Наушники HUAWEI FreeBuds 7i, белые\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/176/392/609/410/151/30/600023584358b0.png\",\"attributes\":[{\"title\":\"Частотный диапазон, в Гц\",\"slug\":\"\",\"value\":\"14-40000\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":111616,\"featureDescription\":\"\"},{\"title\":\"Микрофон\",\"slug\":\"\",\"value\":\"Да\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":118784,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/naushniki-huawei-freebuds-7i-belye-600023584358/\",\"slug\":\"naushniki-huawei-freebuds-7i-belye-600023584358_247992\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":3,\"height\":3,\"length\":8,\"weightUnit\":\"кг\",\"weight\":0.30000001192092896}],\"categoryId\":\"2463684633824595\",\"brand\":\"Huawei\",\"contentFlags\":[],\"contentFlagsStr\":[],\"stocks\":1,\"photosCount\":1,\"offersCount\":1,\"logisticTags\":[],\"images\":[\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/176/392/609/410/151/30/600023584358b0.png\"],\"documents\":[],\"description\":\"Погрузитесь в мир звука с HUAWEI FreeBuds 7i! HUAWEI FreeBuds 7i - это беспроводные наушники, которые обеспечивают высококачественное звучание и комфортное использование. С их помощью вы сможете наслаждаться музыкой, подкастами и звонками в любом месте и в любое время. Активное шумоподавление: Благодаря технологии ANC (Active Noise Cancellation) вы сможете сосредоточиться на музыке, не отвлекаясь на окружающие звуки. Долгое время работы: Наушники обеспечивают до 28 часов воспроизведения с зарядным кейсом, что позволяет вам наслаждаться музыкой в течение всего дня. Комфортная посадка: Эргономичный дизайн и несколько размеров амбушюр обеспечивают надежную и удобную посадку в ушах. Интуитивное управление: Сенсорные панели на наушниках позволяют легко управлять воспроизведением музыки и отвечать на звонки. Быстрая зарядка: Всего 15 минут зарядки обеспечивают до 4 часов воспроизведения, так что вы всегда будете на связи. Эти наушники идеально подходят для активного образа жизни. Они легкие, стильные и предлагают отличное качество звука, что делает их идеальным выбором для любителей музыки и тех, кто ценит комфорт в повседневной жизни. Погрузитесь в мир звука с HUAWEI FreeBuds 7i и наслаждайтесь каждым моментом!\",\"videos\":[],\"mainCollectionId\":\"12392\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":6500,\"priceFrom\":6500,\"priceTo\":0,\"bonusPercent\":0,\"bonusAmount\":0,\"rating\":4.9,\"reviewCount\":7,\"offerCount\":1,\"finalPrice\":5200,\"favoriteOffer\":{\"id\":\"0\",\"price\":6500,\"score\":0,\"isFavorite\":true,\"merchantId\":\"247992\",\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"finalPrice\":5200,\"bonusPercent\":0,\"bonusAmount\":0,\"availableQuantity\":0,\"bonusAmountFinalPrice\":0,\"discounts\":[],\"priceAdjustments\":[],\"deliveryDate\":\"\",\"pickupDate\":\"\",\"merchantOfferId\":\"\",\"merchantName\":\"VYsmart DBS\",\"merchantLogoUrl\":\"\",\"merchantUrl\":\"/shop/vysmart-dbs/\",\"merchantSummaryRating\":0,\"isBpgByMerchant\":false,\"nds\":0,\"oldPrice\":10900,\"oldPriceChangePercentage\":-52,\"maxDeliveryDays\":null,\"bpgType\":\"UNKNOWN_BPG_TYPE\",\"creditPaymentAmount\":0,\"installmentPaymentAmount\":0,\"showMerchant\":null,\"salesBlockInfo\":null,\"dueDate\":\"DEFAULT_DELIVERY_OFFER_