07397\",\"10010426\",\"10017985\",\"10017987\",\"10039699\",\"10066225\",\"10077374\",\"10077375\",\"10077376\",\"10082040\",\"10089103\"],\"hasOtherOffers\":false,\"ranking\":{\"value\":\"0000147442\",\"valueBi\":\"\"},\"auctionInfo\":{\"analytics\":{\"adCode\":\"\",\"adName\":\"\",\"campaignCode\":\"\",\"campaignName\":\"\",\"advertiserId\":0,\"advertiserName\":\"\",\"channels\":[],\"placeName\":[],\"amazMeReference\":\"\",\"adMark\":\"\",\"campaignType\":\"\"},\"ord\":{\"showBadge\":false,\"organizationName\":\"\",\"creativeMarker\":\"\"}},\"goodsIdAlt\":\"600013590236_99804\",\"bonusAmountFinalPriceToStr\":\"до 400\"},{\"goods\":{\"goodsId\":\"600016489903_17319\",\"title\":\"Беспроводные наушники JBL T280TWSX2BLKCN Black (FK-2703546)\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/211/310/842/331/819/37/600016489903b0.jpg\",\"attributes\":[{\"title\":\"Частотный диапазон, в Гц\",\"slug\":\"\",\"value\":\"5-20000\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":111616,\"featureDescription\":\"\"},{\"title\":\"Система активного шумоподавления\",\"slug\":\"\",\"value\":\"Да\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":117760,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/besprovodnoe-naushniki-jbl-t280twsx2blkcn-black-fk-2703546-600016489903/\",\"slug\":\"besprovodnoe-naushniki-jbl-t280twsx2blkcn-black-fk-2703546-600016489903_17319\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":10,\"height\":5,\"length\":13,\"weightUnit\":\"кг\",\"weight\":0.10000000149011612}],\"categoryId\":\"2463684633824595\",\"brand\":\"JBL\",\"contentFlags\":[],\"contentFlagsStr\":[],\"stocks\":1,\"photosCount\":2,\"offersCount\":1,\"logisticTags\":[],\"images\":[\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/211/310/842/331/819/37/600016489903b0.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/211/403/194/431/819/37/600016489903b1.jpg\"],\"documents\":[],\"description\":\"\\u003cp\\u003eБудь на пике звукового наслаждения с беспроводными наушниками JBL T280 – новейшей разработкой от мирового лидера в производстве звукового оборудования JBL. Эта модель – настоящий взрыв эмоций благодаря своему глубокому басу, который будоражит все вокруг и заставляет тело двигаться в ритме музыки. Уникальная технология bluetooth 5.3 обеспечивает высококачественную передачу аудиосигнала без потери качества звука. Для любителей любой музыки Bluetooth 5.3 - это не просто революция в мире звука, это новый уровень звуковых потоков. Легкий вес наушников JBL T280 идеально подходит для людей, которые ценят комфорт и свободу движений во время прослушивания музыки. Наушники также имеют удобную посадку, которая обеспечивает надежную фиксацию наушников в ушах, несмотря на всякие движения. Известно, что наушники JBL T280 способны играть звук с частотной характеристикой от 20 Гц до 20 кГц, что является значительно шире, чем в классических наушниках. Это означает еще большую глубину и точность звукового потока. Интересный факт: Батарея наушников работает до 16 часов, что является весьма впечатляющим результатом в своей категории. Кроме того, эта модель имеет быструю зарядку, и вы сможете забыть о необходимости постоянно заряжать устройство для беспрерывного звукового наслаждения. JBL T280 – это гарантия идеального звучания, удобства и оригинального дизайна в одном флаконе. Беспрекословно стань владельцем этих наушников, которые не оставят равнодушными ни вас, ни окружающих.\\u003c/p\\u003e\\u003cp\\u003eХарактеристики:\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003eВерсия - CN\\u003c/li\\u003e\\u003cli\\u003eЦвет - черный\\u003c/li\\u003e\\u003cli\\u003eВерсия Bluetooth - v 5.3\\u003c/li\\u003e\\u003cli\\u003eАудиодиапазон - от 5 Hz до 20 KHz\\u003c/li\\u003e\\u003cli\\u003eИмпеданс - 16 Ом\\u003c/li\\u003e\\u003cli\\u003eДрайвер - 12 мм\\u003c/li\\u003e\\u003cli\\u003eМикрофон - Есть\\u003c/li\\u003e\\u003cli\\u003eУправление - Сенсорное\\u003c/li\\u003e\\u003cli\\u003eИгровой режим - Есть\\u003c/li\\u003e\\u003cli\\u003eВлагозащита - IPX4 - устойчивы к брызгам\\u003c/li\\u003e\\u003cli\\u003eАвтономность - до 8 часов (до 120 часов в режиме ожидания) до 24 часов вместе с зарядным кейсом\\u003c/li\\u003e\\u003cli\\u003eЁмкость аккумуляторов - 45 mAh (наушников) + 300 mAh (кейс подзарядки)\\u003c/li\\u003e\\u003cli\\u003eВремя зарядки - 1 час, быстрая зарядка - 10 минут зарядки = 90 минут работы\\u003c/li\\u003e\\u003cli\\u003eПорт зарядки: - от USB Type-C (DC 5V)\\u003c/li\\u003e\\u003cli\\u003eВес 1 наушника - 3.4 грамма\\u003c/li\\u003e\\u003c/ul\\u003e\",\"videos\":[],\"mainCollectionId\":\"12392\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":3328,\"priceFrom\":3328,\"priceTo\":0,\"bonusPercent\":0,\"bonusAmount\":0,\"rating\":3.9,\"reviewCount\":25,\"offerCount\":1,\"finalPrice\":3328,\"favoriteOffer\":{\"id\":\"0\",\"price\":3328,\"score\":0,\"isFavorite\":true,\"merchantId\":\"17319\",\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"finalPrice\":3328,\"bonusPercent\":0,\"bonusAmount\":0,\"availableQuantity\":0,\"bonusAmountFinalPrice\":0,\"discounts\":[],\"priceAdjustments\":[],\"deliveryDate\":\"\",\"pickupDate\":\"\",\"merchantOfferId\":\"\",\"merchantName\":\"ТехноИнновация\",\"merchantLogoUrl\":\"\",\"merchantUrl\":\"/shop/tehnoinnovaciya/\",\"merchantSummaryRating\":0,\"isBpgByMerchant\":false,\"nds\":0,\"oldPrice\":99999,\"oldPriceChangePercentage\":-97,\"maxDeliveryDays\":null,\"bpgType\":\"UNKNOWN_BPG_TYPE\",