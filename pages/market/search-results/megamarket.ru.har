isting\":true,\"sequence\":117760,\"featureDescription\":\"\"},{\"title\":\"Микрофон\",\"slug\":\"\",\"value\":\"Нет\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":118784,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/naushniki-behringer-hps5000-600005484179/\",\"slug\":\"naushniki-behringer-hps5000-600005484179\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":19,\"height\":22,\"length\":10,\"weightUnit\":\"кг\",\"weight\":0.30000001192092896}],\"categoryId\":\"2463684633824595\",\"brand\":\"Behringer\",\"contentFlags\":[],\"contentFlagsStr\":[],\"stocks\":1,\"photosCount\":1,\"offersCount\":1,\"logisticTags\":[\"MGT\"],\"images\":[\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/109/241/464/011/019/23/600005484179b0.jpeg\"],\"documents\":[],\"description\":\"Артикул № 188904    Учитывая требования, предъявляемые сегодня к студийному оснащению, правильно подобранные наушники могут коренным образом изменить стиль вашей работы. Вам нужны в первую очередь высокое качество и превосходные частотные характеристики чтобы быть уверенным в получении наилучшего результата при записи и сведении. Мониторные наушники HPS5000 были специально разработаны чтобы не только удовлетворить, но и превзойти ожидания самых взыскательных аудиофилов. Ультра-широкий частотный диапазон, ясно очерченный бас и кристально чистые высокие звуки обеспечивают удивительно отчетливое звуковоспроизведение. Высокоэффективные кобальтовые капсюли, односторонний кабель из бескислородной меди и оптимизированные овальные амбушюры возводят эту модель в ранг достойных студийных наушников. \",\"videos\":[],\"mainCollectionId\":\"12392\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":5315,\"priceFrom\":5315,\"priceTo\":0,\"bonusPercent\":0,\"bonusAmount\":0,\"rating\":4.5,\"reviewCount\":2,\"offerCount\":1,\"finalPrice\"