\"badges\":[],\"crossedPrice\":0,\"crossedPricePeriod\":\"\",\"lastPrice\":8170,\"isAvailable\":true,\"crossedPriceChangePercentage\":0,\"collections\":[\"2351\",\"2352\",\"2611\",\"3175\",\"891042\",\"935596\",\"12011\",\"12392\",\"12635\",\"12782\",\"14497\",\"502202\",\"572617\",\"221766\",\"578125\",\"578134\",\"578138\",\"578150\",\"578155\",\"1114220\",\"1114223\",\"1114224\",\"2123045\",\"2123051\",\"2123054\",\"2123056\",\"2124801\",\"2124804\",\"2138156\",\"2138172\",\"2138262\",\"2138267\",\"6454299\",\"7867205\",\"7892982\",\"7893402\",\"7893580\",\"7970321\",\"8022110\",\"8255223\",\"8255456\",\"8263267\",\"8290795\",\"8407850\",\"8426574\",\"8682767\",\"8826021\",\"8826892\",\"8895787\",\"8916310\",\"8916315\",\"8916323\",\"8916327\",\"8916333\",\"8916336\",\"8916337\",\"8916346\",\"9061213\",\"9345345\",\"9359864\",\"9359865\",\"9383255\",\"9394563\",\"9414118\",\"10015157\",\"35017\",\"111445\",\"144153\",\"523622\",\"523845\",\"575469\",\"4009409\",\"4339901\",\"5025834\",\"7058065\",\"9861464\",\"10069801\",\"10082040\"],\"hasOtherOffers\":false,\"ranking\":{\"value\":\"0000147455\",\"valueBi\":\"\"},\"auctionInfo\":{\"analytics\":{\"adCode\":\"\",\"adName\":\"\",\"campaignCode\":\"\",\"campaignName\":\"\",\"advertiserId\":0,\"advertiserName\":\"\",\"channels\":[],\"placeName\":[],\"amazMeReference\":\"\",\"adMark\":\"\",\"campaignType\":\"\"},\"ord\":{\"showBadge\":false,\"organizationName\":\"\",\"creativeMarker\":\"\"}},\"goodsIdAlt\":\"600009169112_251786\",\"bonusAmountFinalPriceToStr\":\"\"},{\"goods\":{\"goodsId\":\"600014747678_17319\",\"title\":\"Беспроводные наушники Xiaomi Haylou X1 2023 Черный\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/177/308/680/121/121/36/600014747678b0.jpeg\",\"attributes\":[{\"title\":\"Частотный диапазон, в Гц\",\"slug\":\"\",\"value\":\"20-20000\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":111616,\"featureDescription\":\"\"},{\"title\":\"Система активного шумоподавления\",\"slug\":\"\",\"value\":\"Нет\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":false,\"isWebListing\":true,\"sequence\":117760,\"featureDescription\":\"\"},{\"title\":\"Микрофон\",\"slug\":\"\",\"value\":\"Да\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":118784,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/besprovodnye-naushniki-xiaomi-haylou-x1-2023-chernyy-600014747678/\",\"slug\":\"besprovodnye-naushniki-xiaomi-haylou-x1-2023-chernyy-600014747678_17319\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":5,\"height\":6,\"length\":7,\"weightUnit\":\"кг\",\"weight\":0.4000000059604645}],\"categoryId\":\"2463684633824595\",\"brand\":\"Xiaomi\",\"contentFlags\":[],\"contentFlagsStr\":[],\"stocks\":1,\"photosCount\":10,\"offersCount\":1,\"logisticTags\":[],\"images\":[\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/177/308/680/121/121/36/600014747678b0.jpeg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/177/308/681/121/121/36/600014747678b1.jpeg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/177/308/682/121/121/36/600014747678b2.jpeg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/177/308/683/121/121/36/600014747678b3.jpeg\"],\"documents\":[],\"description\":\"\\u003cp\\u003eБеспроводные наушники HAYLOU X1 2023 – ваш надежный спутник в мире музыки и коммуникаций. Их элегантный алюминиевый зарядный кейс привлекает взгляды своим изящным дизайном и матовым покрытием, способным снизить видимость отпечатков пальцев и царапин.\\u003cbr\\u003e\\u003cbr\\u003eБлагодаря чипу Bluetooth 5.3, у вас будет более стабильное и бесперебойное подключение, что гарантирует плавные звонки, воспроизведение и игры. Усиленная антиинтерференция и низкое энергопотребление обеспечивают еще больше скорости и стабильности.\\u003cbr\\u003e\\u003cbr\\u003e12-миллиметровый динамический драйвер создает захватывающее звуковое пространство и мощный звук. Диафрагма с титановым покрытием обеспечивает высокую чувствительность и балансировку низких, средних и высоких частот. HD-кодек обеспечивает богатые звуковые детали и плавную производительность.\\u003cbr\\u003e\\u003cbr\\u003eПолувнутриканальный дизайн наушников обеспечивает оптимальный комфорт. Они идеально подстраиваются под контуры вашего уха благодаря эргономичному дизайну и углу вставки в 60°, принося вам непревзойденный комфорт при ношении.\\u003cbr\\u003e\\u003cbr\\u003eБлагодаря низкой задержке вы сможете наслаждаться игровым процессом в режиме реального времени с четким звуком шагов, выстрелов и спецэффектов.\\u003cbr\\u003e\\u003cbr\\u003eНаслаждайтесь музыкой до 5,5 часов от одного заряда или до 24 часов с использованием зарядного кейса. Погрузитесь в мир музыки и не беспокойтесь о заряде.\\u003cbr\\u003e\\u003cbr\\u003eБлагодаря высокочувствительному микрофону и алгоритму ENC, наушники интеллектуально фильтруют фоновые шумы во время звонков, а также точно подавляют внезапный шум на улице.\\u003cbr\\u003e\\u003cbr\\u003eПодключение к новому устройству стало невероятно простым благодаря функции сброса настроек. Просто нажмите и удерживайте кнопку сброса, и все настройки вернутся к заводским.\\u003cbr\\u003e\\u003cbr\\u003eНастройте звуковые эффекты EQ с помощью приложения HAYLOU Sound в соответствии со своими предпочтениями. Оно также позволяет изменять имя Bluetooth и проверять уровень заряда наушников.\\u003cbr\\u003e\\u003cbr\\u003eВысокоточное сенсорное управление не создаст дискомфорта вам и вашим ушам. Легко переключайтесь между музыкой и звонками, не доставая телефон из кармана.\\u003c/p\\u003e\",\"videos\":[],\"mainCollectionId\":\"12392\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":945,\"priceFrom\":945,\"priceTo\":0,\"bonusPercent\":0,\"bonusAmount\":0,\"rating\":4.5,\"reviewCount\":75,\"offerCount\":1,\"finalPrice\":945,\"favoriteOffer\":{\"id\":\"0\",\"price\":945,\"score\":0,\"isFavorite\":true,\"merchantId\":\"17319\",\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"finalPrice\":945,\"bonusPercent\":0,\"bonusAmount\":0,\"availableQuantity\":0,\"bonusAmountFinalPrice\":0,\"discounts\":[],\"priceAdjustments\":[],\"deliveryDate\":\"\",\"pickupDate\":\"\",\"merchantOfferId\":\"\",\"merchantName\":\"ТехноИнновация\",\"merchantLogoUrl\":\"\",\"merchantUrl\":\"/shop/tehnoinnovaciya/\",\"merchantSummaryRating\":0,\"isBpgByMerchant\":false,\"nds\":0,\"oldPrice\":99999,\"oldPriceChangePercentage\":-99,\"maxDeliveryDays\":null,\"bpgType\":\"UNKNOWN_BPG_TYPE\",\"creditPaymentAmount\":0,\"installmentPaymentAmount\":0,\"showMerchant\":null,\"salesBlockInfo\":null,\"dueDate\":\"DEFAULT_DELIVERY_OFFER_DUE_DATE\",\"dueDateText\":\"\",\"locationId\":\"\",\"spasiboIsAvailable\":false,\"isShowcase\":false,\"loyaltyPromotionFlags\":[],\"pricesPerMeasurement\":[],\"availablePaymentMethods\":[],\"superPrice\":0,\"warehouseId\":\"273795\",\"bnplPaymentParams\":null,\"installmentPaymentParams\":null,\"bonusInfoGroups\":[],\"calculatedDeliveryDate\":\"16 июля\",\"goodsId\":\"\",\"typeFilters\":[],\"goodsSlug\":\"\",\"fastPurchaseOptions\":null,\"bonusAmountFinalPriceToStr\":\"\",\"tags\":[],\"goodsIdAlt\":\"\"},\"relatedItems\":[],\"productSelectors\":[],\"extraOptions\":[],\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"discounts\":[],\"contentFlagsStr\":[],\"contentFlags\":[],\"badges\":[],\"crossedPrice\":0,\"crossedPricePeriod\":\"\",\"lastPrice\":1604,\"isAvailable\":true,\"crossedPriceChangePercentage\":0,\"collections\":[\"2351\",\"2352\",\"2611\",\"3175\",\"891042\",\"935596\",\"12011\",\"12392\",\"12635\",\"12782\",\"14497\",\"502202\",\"572617\",\"7894020\",\"578150\",\"578155\",\"5360921\",\"7755949\",\"7867205\",\"7893402\",\"9194429\",\"9309456\",\"9659368\",\"35573\",\"87137\",\"104002\",\"141100\",\"502872\",\"575283\",\"7899425\",\"4005762\",\"5868378\",\"9816821\",\"9816822\",\"9861464\",\"9995292\",\"10007397\",\"10010426\",\"10039699\",\"10066225\",\"10069801\",\"10077374\",\"10077375\",\"10077376\",\"10082040\",\"10085000\",\"10085004\",\"10085032\",\"10085038\",\"10086244\",\"10089103\"],\"hasOtherOffers\":false,\"ranking\":{\"value\":\"0000147456\",\"valueBi\":\"\"},\"auctionInfo\":{\"analytics\":{\"adCode\":\"\",\"adName\":\"\",\"campaignCode\":\"\",\"campaignName\":\"\",\"advertiserId\":0,\"advertiserName\":\"\",\"channels\":[],\"placeName\":[],\"amazMeReference\":\"\",\"adMark\":\"\",\"campaignType\":\"\"},\"ord\":{\"showBadge\":false,\"organizationName\":\"\",\"creativeMarker\":\"\"}},\"goodsIdAlt\":\"600014747678_17319\",\"bonusAmountFinalPriceToStr\":\"\"},{\"goods\":{\"goodsId\":\"100045674641_251786\",\"title\":\"Беспроводные наушники Marshall Major IV Black\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/114/182/398/251/912/53/100045674641b0.jpg\",\"attributes\":[{\"title\":\"Частотный диапазон, в Гц\",\"slug\":\"\",\"value\":\"20-20000\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":111616,\"featureDescription\":\"\"},{\"title\":\"Система активного шумоподавления\",\"slug\":\"\",\"value\":\"Нет\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":false,\"isWebListing\":true,\"sequence\":117760,\"featureDescription\":\"\"},{\"title\":\"Микрофон\",\"slug\":\"\",\"value\":\"Да\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":118784,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/i-naush-marshall-major-iv-bl-100045674641/\",\"slug\":\"i-naush-marshall-major-iv-bl-100045674641_251786\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":20,\"height\":10,\"length\":20,\"weightUnit\":\"кг\",\"weight\":0.20000000298023224}],\"categoryId\":\"2463684633824595\",\"brand\":\"Marshall\",\"contentFlags\":[],\"contentFlagsStr\":[],\"stocks\":1,\"photosCount\":10,\"offersCount\":1,\"logisticTags\":[\"MGT\"],\"images\":[\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/114/182/398/251/912/53/100045674641b0.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/114/182/398/351/912/53/100045674641b1.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/114/182/398/451/912/53/100045674641b2.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/114/182/398/551/912/53/100045674641b3.jpg\"],\"documents\":[\"https://main-cdn.sbermegamarket.ru/hlr-system/207/624/253/651/912/53/100045674641bi01.pdf\"],\"description\":\"\\u003cp\\u003eБеспроводные наушники Marshall Major IV Black - удивительный продукт, который позволит вам наслаждаться отличным звуком без ограничений проводов. Они сочетают в себе стильный дизайн и передовые технологии.\\u003c/p\\u003e\\n\\u003ch2\\u003eИдеальное сочетание комфорта и качества звука\\u003c/h2\\u003e\\n\\u003cp\\u003eНаслаждайтесь мощным и чистым звуком благодаря акустическому оформлению закрытого типа и диаметру мембраны 40 мм. Благодаря высокой чувствительности в 99 дБ вы сможете услышать каждую ноту ясно и отчетливо. Беспроводное подключение через Bluetooth 5.0 и интерфейс Jack 3.5 позволяют легко подключить наушники к любым устройствам.\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003eУдобство использования - за счет сверхлегкой конструкции (165 г) и складными дужками, наушники просты в переноске и хранении.\\u003c/li\\u003e\\n\\u003cli\\u003eДолгое время работы - аккумулятор Li-Ion обеспечивает до 80 часов непрерывного использования без необходимости повторной зарядки.\\u003c/li\\u003e\\n\\u003cli\\u003eПростое управление - функции управления, такие как завершение вызова, прием вызова и регулировка громкости, позволяют вам контролировать все настройки непосредственно с наушников.\\u003c/li\\u003e\\n\\u003cli\\u003eВысокая надежность - металлическо-пластиковый корпус и крепление из искусственной кожи обеспечивают долгий срок службы и комфортное использование.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003eНаушники Marshall Major IV Black поддерживают протокол SBC, который обеспечивает отличное качество аудио передачи. Их максимальная частота диапазона составляет 20000 Гц, позволяя вам не упустить ни одной детали звука. А благодаря отсоединяемому кабелю вы можете использовать наушники по своему желанию - без провода или с ним.\\u003c/p\\u003e\",\"videos\":[],\"mainCollectionId\":\"12392\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":9450,\"priceFrom\":9450,\"priceTo\":0,\"bonusPercent\":0,\"bonusAmount\":0,\"rating\":4.5,\"reviewCount\":333,\"offerCount\":1,\"finalPrice\":6993,\"favoriteOffer\":{\"id\":\"0\",\"price\":9450,\"score\":0,\"isFavorite\":true,\"merchantId\":\"251786\",\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"finalPrice\":6993,\"bonusPercent\":0,\"bonusAmount\":0,\"availableQuantity\":0,\"bonusAmoun