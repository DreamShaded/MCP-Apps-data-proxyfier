d\":{\"showBadge\":false,\"organizationName\":\"\",\"creativeMarker\":\"\"}},\"goodsIdAlt\":\"600004381095_99804\",\"bonusAmountFinalPriceToStr\":\"до 1 098\"},{\"goods\":{\"goodsId\":\"600023665151_263576\",\"title\":\"Беспроводные наушники Samsung Galaxy Buds 4 Pro (R640NZWA), черный\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/175/850/444/932/614/0/600023665151b0.png\",\"attributes\":[{\"title\":\"Частотный диапазон, в Гц\",\"slug\":\"\",\"value\":\"20-40000\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":111616,\"featureDescription\":\"\"},{\"title\":\"Микрофон\",\"slug\":\"\",\"value\":\"Да\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":118784,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/besprovodnye-naushniki-samsung-galaxy-buds-4-pro-r640nzwa-chernyy-600023665151/\",\"slug\":\"besprovodnye-naushniki-samsung-galaxy-buds-4-pro-r640nzwa-chernyy-600023665151_263576\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":3,\"height\":3,\"length\":6,\"weightUnit\":\"кг\",\"weight\":0.10000000149011612}],\"categoryId\":\"2463684633824595\",\"brand\":\"Samsung\",\"contentFlags\":[],\"contentFlagsStr\":[],\"stocks\":1,\"photosCount\":1,\"offersCount\":1,\"logisticTags\":[],\"images\":[\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/175/850/444/932/614/0/600023665151b0.png\"],\"documents\":[],\"description\":\"Познакомьтесь с наушниками Galaxy Buds4 Pro с настоящим Hi-Fi. Улучшенный двойной драйвер с двухканальным усилителем точно откалиброван для воспроизведения высококачественного звука по всему частотному диапазону. Аудиокодек SSC (Samsung Seamless Codec) воспроизводит звук с максимальной частотой дискретизации 96 кГц и разрядностью до 24 бит, сохраняя оригинальное звучание без потери качества. Эргономичный дизайн Новый эргономичный дизайн наушников со вставкой из натурального алюминия не только облегчает управление, но и привлекает к себе внимание. Изящные формы корпуса и надёжная магнитная фиксация - улучшенный зарядный кейс с поддержкой беспроводной зарядки превращает повседневное использование наушников в удовольствие. Адаптивное активное шумоподавление Функция Адаптивного активного шумоподавления на Galaxy Buds4 Pro в режиме реального времени регулирует громкость окружающих звуков, адаптируясь к обстановке. Не снимайте Galaxy Buds4 Pro, даже если началась беседа. Как только вы начнёте говорить, система автоматически переключит наушники в режим Звукового Окружения. Оставайтесь в центре событий, не упуская ни малейшей детали. Быстрое подключение Просто откройте зарядный кейс - всё уже готово к работе: никаких приложений, загрузок или лишних действий. Ваш смартфон Galaxy и планшет Galaxy Tab автоматически распознают Galaxy Buds4 Pro для быстрого подключения.\",\"videos\":[],\"mainCollectionId\":\"12392\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":21490,\"priceFrom\":21490,\"priceTo\":0,\"bonusPercent\":0,\"bonusAmount\":0,\"rating\":5,\"reviewCount\":4,\"offerCount\":1,\"finalPrice\":21490,\"favoriteOffer\":{\"id\":\"0\",\"price\":21490,\"score\":0,\"isFavorite\":true,\"merchantId\":\"263576\",\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"finalPrice\":21490,\"bonusPercent\":0,\"bonusAmount\":0,\"availableQuantity\":0,\"bonusAmountFinalPrice\":0,\"discounts\":[],\"priceAdjustments\":[],\"deliveryDate\":\"\",\"pickupDate\":\"\",\"merchantOfferId\":\"\",\"merchantName\":\"iOriginal Store\",\"merchantLogoUrl\":\"\",\