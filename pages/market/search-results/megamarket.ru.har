zationName\":\"\",\"creativeMarker\":\"\"}},\"goodsIdAlt\":\"100071684345_243911\",\"bonusAmountFinalPriceToStr\":\"до 956\"},{\"goods\":{\"goodsId\":\"100028934866_17319\",\"title\":\"Наушники JBL Wave 200 (JBLW200TWSWHT)\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/208/778/260/912/217/9/100028934866b0.jpg\",\"attributes\":[{\"title\":\"Частотный диапазон, в Гц\",\"slug\":\"\",\"value\":\"20-20000\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":111616,\"featureDescription\":\"\"},{\"title\":\"Система активного шумоподавления\",\"slug\":\"\",\"value\":\"Нет\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":false,\"isWebListing\":true,\"sequence\":117760,\"featureDescription\":\"\"},{\"title\":\"Микрофон\",\"slug\":\"\",\"value\":\"Да\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":118784,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/naushniki-jbl-wave-200-jblw200twswht-100028934866/\",\"slug\":\"naushniki-jbl-wave-200-jblw200twswht-100028934866_17319\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":15,\"height\":20,\"length\":7,\"weightUnit\":\"кг\",\"weight\":0.20000000298023224}],\"categoryId\":\"2463684633824595\",\"brand\":\"JBL\",\"contentFlags\":[],\"contentFlagsStr\":[\"matrix_smkt\"],\"stocks\":1,\"photosCount\":4,\"offersCount\":1,\"logisticTags\":[\"MGT\"],\"images\":[\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/208/778/260/912/217/9/100028934866b0.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/208/778/261/012/217/9/100028934866b1.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/208/778/261/112/217/9/100028934866b2.jpg\",\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/208/778/261/212/217/9/100028934866b3.jpg\"],\"documents\":[],\"description\":\"\\u003cp\\u003eВысококачественные наушники JBL Wave 200 (JBLW200TWSWHT) - это беспроводное устройство с безупречным звучанием и стильным дизайном.\\u003c/p\\u003e\\n\\u003ch2\\u003eНаслаждайтесь музыкой в полной свободе!\\u003c/h2\\u003e\\n\\u003cp\\u003eСоберите все преимущества беспроводных наушников JBL Wave 200 в одну фразу: \\\"Наушники, которые позволят вам наслаждаться музыкой без проводов!\\\"\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003eБеспроводное подключение Bluetooth 5.0 обеспечивает стабильную связь с вашим устройством.\\u003c/li\\u003e\\n\\u003cli\\u003eTrue Wireless Stereo технология позволяет наслаждаться моно- или стереозвуком.\\u003c/li\\u003e\\n\\u003cli\\u003eАккумулятор Li-Ion обеспечивает до 2 часов непрерывного использования после всего 2-часового заряда.\\u003c/li\\u003e\\n\\u003cli\\u003eВнутриканальная конструкция и закрытое акустическое оформление гарантируют высокое качество звучания и отличную изоляцию от окружающего шума.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003eДополнительно, наушники JBL Wave 200 оснащены USB Type-C разъемом для удобной зарядки и сменными амбушюрами из силикона. С чувствительностью 108 дБ и импедансом 16 Ом, эти наушники позволят вам наслаждаться каждой деталью звучания в широком частотном диапазоне от 20 до 20000 Гц.\\u003c/p\\u003e\",\"videos\":[],\"mainCollectionId\":\"12392\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":3311,\"priceFrom\":3311,\"priceTo\":0,\"bonusPercent\":0,\"bonusAmount\":0,\"rating\":4.5,\"reviewCount\":418,\"offerCount\":1,\"finalPrice\":3311,\"favoriteOffer\":{\"id\":\"0\",\"price\":3311,\"score\":0,\"isFavorite\":true,\"merchantId\":\"17319\",\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliv