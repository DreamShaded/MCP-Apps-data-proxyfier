":false,\"ranking\":null,\"auctionInfo\":null,\"goodsIdAlt\":\"600011586917_18910\",\"bonusAmountFinalPriceToStr\":\"\"},{\"goods\":{\"goodsId\":\"100030816052\",\"title\":\"Установка сплит-системы/кондиционера мощностью от 2800 Вт до 4050 Вт в режиме охлаждения\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/-19/782/783/211/227/100030816052b0.jpg\",\"attributes\":[{\"title\":\"Вид установки\",\"slug\":\"\",\"value\":\"монтаж\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":10,\"featureDescription\":\"\"},{\"title\":\"Вид техники\",\"slug\":\"\",\"value\":\"сплит-система\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":20,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/ustanovka-split-sistemy-kondicionera-moshnostyu-ot-2800-vt-do-4050-vt-v-rezhime-ohlazhdeniya-100030816052/\",\"slug\":\"ustanovka-split-sistemy-kondicionera-moshnostyu-ot-2800-vt-do-4050-vt-v-rezhime-ohlazhdeniya-100030816052\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":0.10000000149011612,\"height\":24,\"length\":29,\"weightUnit\":\"кг\",\"weight\":0.10000000149011612}],\"categoryId\":\"\",\"brand\":\"NoBrand\",\"contentFlags\":[\"service\"],\"contentFlagsStr\":[\"service\"],\"stocks\":1,\"photosCount\":1,\"offersCount\":4,\"logisticTags\":[\"MGT\"],\"images\":[\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/-19/782/783/211/227/100030816052b0.jpg\"],\"documents\":[],\"description\":\"\\u003cp\\u003eПравила заказа услуг по ссылке: https://sbermegamarket.ru/info/pravila-zakaza-uslug\\u003c/p\\u003e\\r\\n\\r\\n\\u003cp\\u003e\\u0026nbsp;\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eВходит в услугу\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u0026nbsp;\\u003c/p\\u003e\\u003cp\\u003e* Выезд специалиста в пределах границы города (для г. Москва выезд в пределах МКАД)\\u003c/p\\u003e\\u003cp\\u003e* Установка угловых кронштейнов на основную стену (без вентфасада и других конструкций)\\u003c/p\\u003e\\u003cp\\u003e* Установка внешнего блока под окном или на балконе (без использования автовышки и работ альпиниста)\\u003c/p\\u003e\\u003cp\\u003e* Сверление одного отверстия диаметром до 45 мм в стене толщиной до 80 см\\u003c/p\\u003e\\u003cp\\u003e* Устройство магистрали открытой прокладки до 2 метров\\u003c/p\\u003e\\u003cp\\u003e* Герметизация отверстия монтажной пеной без отделки\\u003c/p\\u003e\\u003cp\\u003e* Установка внутреннего блока\\u003c/p\\u003e\\u003cp\\u003e* Проверка давления фреона (хладагента)\\u003c/p\\u003e\\u003cp\\u003e* Подключение кондиционера к существующей розетке, настройка его работы, проверка основных режимов работы\\u003c/p\\u003e\\u003cp\\u003e* Очистка рабочей зоны и уборка мусора\\u003c/p\\u003e\\u003cp\\u003e* Демонстрация работы и объяснение основных функций\\u003c/p\\u003e\\u003cp\\u003eРасходные материалы:\\u003c/p\\u003e\\u003cp\\u003e* Кронштейны крепления наружного блока (1 пара)\\u003c/p\\u003e\\u003cp\\u003e* Трубка медная\\u003c/p\\u003e\\u003cp\\u003e* Термоизоляция для трубки медной (2 метра)\\u003c/p\\u003e\\u003cp\\u003e* Кабель электрический ПВС (2 метра)\\u003c/p\\u003e\\u003cp\\u003e* Дренажный шланг диаметром 16 мм (2 метра)\\u003c/p\\u003e\\u003cp\\u003e* Лента изоляционная армированная\\u003c/p\\u003e\\u003cp\\u003e* Дюбель-гвоздь 6х40 (крепление внутреннего блока)\\u003c/p\\u003e\\u003cp\\u003e* Крепеж 10x100 (крепление наружнего блока)\\u003c/p\\u003e\\u003cp\\u003e\\u0026nbsp;\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eНе входит в услугу\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u0026nbsp;\\u003c/p\\u003e\\u003cp\\u003e* Услуги автовышки и работы альпиниста\\u003c/p\\u003e\\u003cp\\u003e* Демонтаж старого кондиционера\\u003c/p\\u003e\\u003cp\\u003e* Межблочная магистраль более 2 метров\\u0026nbsp;\\u003c/p\\u003e\\u003cp\\u003e* Вывод дренажа в канализацию\\u0026nbsp;\\u003c/p\\u003e\\u003cp\\u003e* Доработка розеток и электросети\\u003c/p\\u003e\\u003cp\\u003e* Материалы, не входящие в стандартную установку\\u003c/p\\u003e\\u003cp\\u003e* Выезд за границу города\\u003c/p\\u003e\\u003cp\\u003e* Утилизация упаковки\\u003c/p\\u003e\",\"videos\":[],\"mainCollectionId\":\"0\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":18500,\"priceFrom\":18500,\"priceTo\":0,\"bonusPercent\":0,\"bonusAmount\":0,\"rating\":4.4,\"reviewCount\":78,\"offerCount\":4,\"finalPrice\":18500,\"favoriteOffer\":{\"id\":\"0\",\"price\":18500,\"score\":0,\"isFavorite\":true,\"merchantId\":\"102291\",\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"finalPrice\":18500,\"bonusPercent\":0,\"bonusAmount\":0,\"availableQuantity\":0,\"bonusAmountFinalPrice\":0,\"discounts\":[],\"priceAdjustments\":[],\"deliveryDate\":\"\",\"pickupDate\":\"\",\"merchantOfferId\":\"\",\"merchantName\":\"Danro\",\"merchantLogoUrl\":\"\",\"merchantUrl\":\"\",\"merchantSummaryRating\":0,\"isBpgByMerchant\":false,\"nds\":0,\"oldPrice\":0,\"oldPriceChangePercentage\":0,\"maxDeliveryDays\":null,\"bpgType\":\"UNKNOWN_BPG_TYPE\",\"creditPaymentAmount\":0,\"installmentPaymentAmount\":0,\"showMerchant\":null,\"salesBlockInfo\":null,\"dueDate\":\"DEFAULT_DELIVERY_OFFER_DUE_DATE\",\"dueDateText\":\"\",\"locationId\":\"\",\"spasiboIsAvailable\":false,\"isShowcase\":false,\"loyaltyPromotionFlags\":[],\"pricesPerMeasurement\":[],\"availablePaymentMethods\":[],\"superPrice\":0,\"warehouseId\":\"1798340\",\"bnplPaymentParams\":null,\"installmentPaymentParams\":null,\"bonusInfoGroups\":[],\"calculatedDeliveryDate\":