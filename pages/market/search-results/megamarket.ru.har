"advertiserId\":0,\"advertiserName\":\"\",\"channels\":[],\"placeName\":[],\"amazMeReference\":\"\",\"adMark\":\"\",\"campaignType\":\"\"},\"ord\":{\"showBadge\":false,\"organizationName\":\"\",\"creativeMarker\":\"\"}},\"goodsIdAlt\":\"600007347317_247992\",\"bonusAmountFinalPriceToStr\":\"\"},{\"goods\":{\"goodsId\":\"600023663752_126445\",\"title\":\"Bluetooth-гарнитура Samsung Galaxy Buds 4 Pro (R640NZWA), белый\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/170/678/823/432/410/45/600023663752b0.png\",\"attributes\":[{\"title\":\"Частотный диапазон, в Гц\",\"slug\":\"\",\"value\":\"20-20000\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":111616,\"featureDescription\":\"\"},{\"title\":\"Микрофон\",\"slug\":\"\",\"value\":\"Да\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":118784,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/bluetooth-garnitura-samsung-galaxy-buds-4-pro-r640nzwa-belyy-600023663752/\",\"slug\":\"bluetooth-garnitura-samsung-galaxy-buds-4-pro-r640nzwa-belyy-600023663752_126445\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":3,\"height\":3,\"length\":6,\"weightUnit\":\"кг\",\"weight\":0.10000000149011612}],\"categoryId\":\"2463684633824595\",\"brand\":\"Samsung\",\"contentFlags\":[],\"contentFlagsStr\":[],\"stocks\":1,\"photosCount\":1,\"offersCount\":1,\"logisticTags\":[],\"images\":[\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/170/678/823/432/410/45/600023663752b0.png\"],\"documents\":[],\"description\":\"Познакомьтесь с наушниками Galaxy Buds4 Pro с настоящим Hi-Fi. Улучшенный двойной драйвер с двухканальным усилителем точно откалиброван для воспроизведения высококачественного звука по всему частотному диапазону. Аудиокодек SSC (Samsung Seamless Codec) воспроизводит звук с максимальной частотой дискретизации 96 кГц и разрядностью до 24 бит, сохраняя оригинальное звучание без потери качества. Эргономичный дизайн Новый эргономичный дизайн наушников со вставкой из натурального алюминия не только облегчает управление, но и привлекает к себе внимание. Изящные формы корпуса и надёжная магнитная фиксация - улучшенный зарядный кейс с поддержкой беспроводной зарядки превращает повседневное использование наушников в удовольствие. Адаптивное активное шумоподавление Функция Адаптивного активного шумоподавления на Galaxy Buds4 Pro в режиме реального времени регулирует громкость окружающих звуков, адаптируясь к обстановке. Не снимайте Galaxy Buds4 Pro, даже если началась беседа. Как только вы начнёте говорить, система автоматически переключит наушники в режим Звукового Окружения. Оставайтесь в центре событий, не упуская ни малейшей детали. Быстрое подключение Просто откройте зарядный кейс - всё уже готово к работе: никаких приложений, загрузок или лишних действий. Ваш смартфон Galaxy и планшет Galaxy Tab автоматически распознают Galaxy Buds4 Pro для быстрого подключения.\",\"videos\":[],\"mainCollectionId\":\"12392\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":17780,\"priceFrom\":17780,\"priceTo\":0,\"bonusPercent\":0,\"bonusAmount\":0,\"rating\":3,\"reviewCount\":2,\"offerCount\":1,\"finalPrice\":15841,\"favoriteOffer\":{\"id\":\"0\",\"price\":17780,\"score\":0,\"isFavorite\":true,\"merchantId\":\"126445\",\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"finalPrice\":15841,\"bonusPercent\":0,\"bonusAmount\":0,\"availableQuantity\":0,\"bonusAmountFinalPrice\":0,\"discounts\":[],\"priceAdjustments\":[],\"del