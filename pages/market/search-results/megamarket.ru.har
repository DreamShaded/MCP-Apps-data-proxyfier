\",\"bnplPaymentParams\":null,\"installmentPaymentParams\":null,\"bonusInfoGroups\":[],\"calculatedDeliveryDate\":\"Завтра\",\"goodsId\":\"\",\"typeFilters\":[],\"goodsSlug\":\"\",\"fastPurchaseOptions\":null,\"bonusAmountFinalPriceToStr\":\"\",\"tags\":[],\"goodsIdAlt\":\"\"},\"relatedItems\":[],\"productSelectors\":[],\"extraOptions\":[],\"deliveryPossibilities\":[{\"code\":\"COURIER\",\"date\":\"\",\"amount\":1,\"isDefault\":false,\"maxDeliveryDays\":null,\"appliedPromotionTags\":[],\"isDbm\":true,\"deliveryPriceType\":\"UNKNOWN_DELIVERY_PRICE_DISPLAY_TYPE\",\"displayName\":\"Доставит продавец\\nот 2 дней\",\"displayDeliveryDate\":\"\",\"deliveryOptions\":[],\"darkstoreExternalId\":\"\",\"minCheck\":0}],\"discounts\":[],\"contentFlagsStr\":[\"matrix_smkt\"],\"contentFlags\":[],\"badges\":[],\"crossedPrice\":0,\"crossedPricePeriod\":\"\",\"lastPrice\":20800,\"isAvailable\":true,\"crossedPriceChangePercentage\":0,\"collections\":[\"2351\",\"2352\",\"2611\",\"3175\",\"891042\",\"935596\",\"12011\",\"12392\",\"12635\",\"12782\",\"14497\",\"502202\",\"572617\",\"578150\",\"578155\",\"5360921\",\"7755949\",\"7867205\",\"7893402\",\"8263267\",\"8290795\",\"8916310\",\"8916315\",\"8916323\",\"8916327\",\"8916333\",\"8916336\",\"8916337\",\"8916346\",\"9194429\",\"9309456\",\"9359864\",\"9359865\",\"9427923\",\"35017\",\"111445\",\"144153\",\"523622\",\"523845\",\"575469\",\"4009409\",\"4335011\",\"4339059\",\"6373868\",\"9099066\",\"9816821\",\"9843735\",\"9861444\",\"9861461\",\"9861464\",\"9908785\",\"9995292\",\"10007079\",\"10007397\",\"10010426\",\"10012688\",\"10023494\",\"10039699\",\"10047243\",\"10066225\",\"10069801\",\"10077374\",\"10077375\",\"10077376\",\"10082040\",\"10082528\",\"10084003\",\"10084363\",\"10085002\",\"10085012\",\"10086518\",\"10086522\",\"10089103\",\"10089105\"],\"hasOtherOffers\":false,\"ranking\":{\"value\":\"0000147415\",\"valueBi\":\"\"},\"auctionInfo\":{\"analytics\":{\"adCode\":\"\",\"adName\":\"\",\"campaignCode\":\"\",\"campaignName\":\"\",\"advertiserId\":0,\"advertiserName\":\"\",\"channels\":[],\"placeName\":[],\"amazMeReference\":\"\",\"adMark\":\"\",\"campaignType\":\"\"},\"ord\":{\"showBadge\":false,\"organizationName\":\"\",\"creativeMarker\":\"\"}},\"goodsIdAlt\":\"100061445418_57988\",\"bonusAmountFinalPriceToStr\":\"\"},{\"goods\":{\"goodsId\":\"600010245640_247992\",\"title\":\"Беспроводные наушники Apple AirPods Pro 3, белый\",\"titleImage\":\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/coming_soon.png\",\"attributes\":[{\"title\":\"Частотный диапазон, в Гц\",\"slug\":\"\",\"value\":\"20-20000\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":90,\"featureDescription\":\"Параметр определяет пределы звуков, какие могут быть воспроизведены наушниками. Считается, что человек слышит частоты от 20 Гц до 20 кГц и аналогичного диапазона у наушников вполне достаточно. Более широкий частотный диапазон предполагает, что слышимый диапазон будет воспроизведен от 20 Гц до 20 кГц с меньшим спадом АЧХ по краям и меньшими искажения в области низких частот.\"},{\"title\":\"Система активного шумоподавления\",\"slug\":\"\",\"value\":\"Да\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":140,\"featureDescription\":\"В наушниках с активным шумоподавлением есть внешний микрофон, который улавливает шум, далее технология анализирует этот шум и, измерив его амплитуду, формирует в ответ зеркальную звуковую волну. Две волны перекрывают друг друга, благодаря чему внешний шум пропадает\"},{\"title\":\"Микрофон\",\"slug\":\"\",\"value\":\"Да\",\"group\":{\"title\":\"Основные характеристики\",\"slug\":\"\"},\"isWebShort\":true,\"isWebListing\":true,\"sequence\":150,\"featureDescription\":\"\"}],\"webUrl\":\"https://megamarket.ru/catalog/details/besprovodnye-naushniki-apple-airpods-pro-3-belyy-600010245640/\",\"slug\":\"besprovodnye-naushniki-apple-airpods-pro-3-belyy-600010245640_247992\",\"boxes\":[{\"box\":\"1\",\"packagingUnit\":\"см\",\"width\":20,\"height\":10,\"length\":10,\"weightUnit\":\"кг\",\"weight\":0.5}],\"categoryId\":\"2463684633824595\",\"brand\":\"Apple\",\"contentFlags\":[\"theft_risk\"],\"contentFlagsStr\":[\"theft_risk\"],\"stocks\":1,\"photosCount\":1,\"offersCount\":1,\"logisticTags\":[\"MGT\"],\"images\":[\"https://main-cdn.sbermegamarket.ru/mid9/hlr-system/coming_soon.png\"],\"documents\":[],\"description\":\"AirPods Pro - невероятно легкие наушники с функцией шумоподавления. Они блокируют окружающие звуки, чтобы Вас ничто не отвлекало. Технология активного шумоподавления заглушает внешние шумы, постоянно адаптируя воспроизведение аудио с учетом уникальной геометрии вашего уха и размера вкладышей. Поэтому Вы можете полностью сосредоточиться на музыке, подкасте или телефонном разговоре Процессор System in Package на базе чипа H1: чип H1, разработанный Apple, позволяет воспроизводить аудио с минимальной задержкой. С помощью датчика нажатия на корпусе можно легко управлять музыкой и звонками Благодаря внутренним и наружным микрофонам AirPods Pro способны компенсировать изолирующий эффект силиконовых вкладышей, чтобы внешний мир звучал так же естественно, как если бы Вы общались без наушников Потрясающее качество звука: драйвер с широкой амплитудой и низким уровнем искажений отлично передает низкие частоты. Высокоэффективный усилитель с широким динамическим диапазоном обеспечивает четкое, чистое звучание и при этом экономно расходует заряд аккумулятора. А адаптивный эквалайзер автоматически регулирует параметры звука с учетом геометрии вашего уха, создавая неизменно богатое звучание Простая настройка для работы с любыми устройствами Apple Автоматическое включение и подключение к устройству\",\"videos\":[],\"mainCollectionId\":\"12392\",\"package\":{\"packageType\":\"PIECE_TYPE\",\"minQuantity\":\"0\",\"weightUnit\":\"UNKNOWN_WEIGHT_UNIT\"}},\"price\":30000,\"priceFrom\":30000,\"priceTo\":0,\"bonusPercent\"